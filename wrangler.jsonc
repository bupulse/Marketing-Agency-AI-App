{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bupulse",
  // Wraps .open-next/worker.js and adds the scheduled handler for the cron triggers below.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Wrangler re-prints the OpenNext bundle with all its whitespace; minified, the Worker is about 1 MiB smaller gzipped
  // (limit 10 MiB, docs/DEPLOY.md "Known notes"). keep_names (wrangler's default) keeps function and class names.
  "minify": true,
  "keep_names": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference, the service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bupulse"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // TODO: replace with the id from `wrangler hyperdrive create` (see docs/DEPLOY.md).
      "id": "TODO_HYPERDRIVE_CONFIG_ID",
      // Used by `npm run preview` so the local worker can reach the database.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  // Converting big photos to JPEG for Instagram is CPU heavy. The default is 30 s per invocation; this allows 2 minutes
  // (Workers Paid, max 300000). Waiting on networks and AI does not count as CPU; a cron run may last up to 15 minutes.
  "limits": { "cpu_ms": 120000 },
  "triggers": {
    // The schedules and their routes are in worker-crons.ts (tests/worker-crons.test.ts keeps both lists equal). Every
    // minute: publish due posts. Hourly: metrics (:23), leads summary (:37), trial reminders (:53), content summary (:07).
    // Daily (UTC): analytics roll-up 02:17, media cleanup 03:19, store sync 03:47, plan price changes 04:29, Mobile
    // Money renewals and offer reminders 05:41. Every 3 hours on Fridays and Saturdays: Autopilot. Every 4 minutes: the
    // Video Studio's sweep. Hourly at :13: daily posts. 13 triggers; Workers Paid allows 250 per account.
    "crons": ["* * * * *", "23 * * * *", "11 */3 * * 5,6", "*/30 * * * 5,6,0", "37 * * * *", "47 3 * * *", "17 2 * * *", "29 4 * * *", "41 5 * * *", "53 * * * *", "19 3 * * *", "7 * * * *", "*/4 * * * *", "13 * * * *", "31 */6 * * *"]
  },
  "observability": { "enabled": true }
  // Custom domains (bupulse.com, staging.bupulse.com) are added later, see docs/DEPLOY.md.
}
