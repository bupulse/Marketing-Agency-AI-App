{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bupulse",
  // Wraps .open-next/worker.js and adds the scheduled handler for the cron triggers below.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference, the service name must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bupulse"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // TODO: replace with the id from `wrangler hyperdrive create` (see docs/DEPLOY.md).
      "id": "TODO_HYPERDRIVE_CONFIG_ID",
      // Used by `npm run preview` so the local worker can reach the database.
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  // Converting big photos to JPEG for Instagram is CPU heavy. The default is 30 s per invocation; this allows 2 minutes
  // (Workers Paid, max 300000). Cron runs may also wait on networks for a while: they are not limited by wall time.
  "limits": { "cpu_ms": 120000 },
  "triggers": {
    // Every minute: publish due posts. Hourly at :23: collect post metrics (METRICS_CRON in worker.ts); each post is measured at most once every 20 hours. Every 3 hours on Fridays and Saturdays: Autopilot plans next week (AUTOPILOT_CRON). Hourly at :37: the leads summary email, sent to businesses where it is 08:00 (LEADS_DIGEST_CRON). Daily at 03:47 UTC: re-sync imported store products (STORE_SYNC_CRON). Daily at 02:17 UTC: analytics roll-up (ANALYTICS_ROLLUP_CRON).
    "crons": ["* * * * *", "23 * * * *", "11 */3 * * 5,6", "37 * * * *", "47 3 * * *", "17 2 * * *"]
  },
  "observability": { "enabled": true }
  // Custom domains (bupulse.com, staging.bupulse.com) are added later, see docs/DEPLOY.md.
}
