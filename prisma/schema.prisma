// BuPulse database schema (Supabase Postgres).
// Auth users live in Supabase's own `auth.users` table; `User.id` is that same UUID.

// relationJoins: a query that reads related rows (include / nested select) is one SQL query with joins instead of one
// round trip per relation level; about 250 ms a level from the test site. Checked on TEST (23 Oct 2026): every model
// read with its relations gives the same rows both ways (docs/handovers/client-qa.md).
generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum SubscriptionStatus {
  // New sign-ups: a plan is chosen and a demo booked, nothing else works until an admin starts the trial (docs/REGIONS.md).
  PENDING_DEMO
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

// How the account was created. Password accounts sign in with their password only;
// Google accounts sign in with Google (or a password too, once they set one by resetting it).
enum SignUpMethod {
  PASSWORD
  GOOGLE
}

model User {
  id                   String           @id @db.Uuid
  email                String           @unique
  name                 String?
  signUpMethod         SignUpMethod     @default(PASSWORD)
  // Set when the owner asks to delete the account; everything is erased after this date
  // unless they sign in and cancel (30-day grace period).
  deletionScheduledFor DateTime?
  // Set by the admin console (suspend_user). A suspended user cannot sign in or use the app; data is kept.
  suspendedAt          DateTime?
  suspendedReason      String?
  // Last time this person used the dashboard (a throttled heartbeat, lib/staff/heartbeat.ts): "active now" on the
  // sales screen counts the last 5 minutes.
  lastSeenAt           DateTime?
  createdAt            DateTime         @default(now())
  business             Business?
  membership           Membership?
  subscription         Subscription?
  usage                UsageRecord[]
  videoDays            VideoDayUsage[]
  canva                CanvaConnection?
  canvaEdits           CanvaEdit[]
  manualPayments       ManualPayment[]
  renewalNotices       RenewalNotice[]
  pushSubscriptions    PushSubscription[]
  creator              CreatorProfile?

  @@index([lastSeenAt])
  assignedConversations Conversation[] @relation("ConversationAssignee")
}

// One business per user for now. Industry-neutral: a phone shop, a school,
// a builder and an estate agent all use the same fields.
model Business {
  id                      String    @id @default(cuid())
  userId                  String    @unique @db.Uuid
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  // Deprecated, kept readable: the sector's name, or the owner's own words when they chose "Other". Written alongside
  // industryId / industryOther on every save so analytics, the Autopilot playbook tags and the design packs keep working.
  industry                String?
  // The sector chosen at sign-up (Admin -> Industries). Null when the owner picked "Other" (industryOther) or signed up before industries were data.
  industryId              String?
  industryRef             Industry? @relation(fields: [industryId], references: [id], onDelete: SetNull)
  industryOther           String? // "Other": the owner's own industry text, grouped into suggestions for the admin
  industryDescription     String? // "Describe your business" at sign-up (required from 12 October 2026); the AI's first facts about the company
  description             String? // what they sell (onboarding step 1; prefilled from industryDescription)
  audience                String? // who their customers are
  tone                    String? // brand voice preset id from lib/brand/voices.ts, e.g. "friendly"
  contentLanguage         String    @default("English") // language the AI writes in (lib/brand/languages.ts)
  logoUrl                 String? // object path in the private "brand" bucket (<userId>/logo/...)
  brandColors             String[]
  website                 String?
  ceoName                 String? // from the sign-up form
  country                 String? // from the sign-up form
  phone                   String? // from the sign-up form
  detailsCompletedAt      DateTime? // set once the organisation details are filled in; Google sign-ups do it on /welcome
  onboardedAt             DateTime? // set when the brand onboarding (/onboarding) is finished
  instagramHandle         String?
  knowledge               Json? // facts the chat widget may answer from (lib/brand/schemas.ts knowledgeSchema)
  profile                 Json? // Knowledge base -> Company profile: tagline, mission, values... (lib/knowledge/profile.ts)
  audienceNotes           String? // Knowledge base -> Customers & audience: overall notes next to the personas
  positioning             Json? // Knowledge base -> Competitors: differentiators and positioning statement (lib/knowledge/competitors.ts)
  policies                Json? // Knowledge base -> FAQs & policies: delivery, returns, payment... (lib/knowledge/policies.ts)
  marketingProfile        Json? // Knowledge base -> AI marketing interview: the approved brand voice (lib/knowledge/interview.ts)
  widgetKey               String    @unique @default(cuid()) // public id used by the embed snippet
  composioApiKeyEncrypted String? // Pro users' own Composio key, encrypted with lib/crypto.ts
  timezone                String    @default("UTC") // IANA zone for the calendar and posting times, e.g. "Africa/Kigali"
  // PricingRegion.key, set from the sign-up country (lib/region.ts). Billing always uses this, never the visitor's IP.
  pricingRegion           String    @default("GLOBAL")
  // Soft region check (lib/region-check.ts): the IP country seen at sign-up or a payment start mapped to a dearer
  // region than pricingRegion. Never blocks; shown to the admin with "Change region". Kept after a dismissal (dismissedAt)
  // so the same country is not flagged again; regionMismatchAt is set only while the flag is open (the attention list).
  regionMismatch          Json?
  regionMismatchAt        DateTime?
  // Content -> Settings (docs/CONTENT.md): per app, whether new posts wait for approval (lib/content-board/settings.ts).
  // Null: approval required for every app.
  contentSettings         Json?
  // When the daily "what was auto-scheduled" email last went out (lib/content-board/summary.ts).
  contentSummarySentAt    DateTime?
  // "Create today's content" (docs/CONTENT.md): one run at a time per company. The run's request key (from the dialog)
  // and until when it holds the claim; the key stays after the run so the same request is never run twice.
  contentRunKey           String?
  contentRunUntil         DateTime?
  // Daily posts made for you (docs/CONTENT.md "Daily posts"): on or off, posts per app, apps and design style
  // (lib/daily-posts/settings.ts). Null: the defaults (on, one post per app, the connected apps, free designs).
  dailyPostSettings       Json?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  projects         Project[]
  products         Product[]
  campaigns        Campaign[]
  contents         GeneratedContent[]
  demoBookings     DemoBooking[]
  designs          Design[]
  contentVisuals   ContentVisual[]
  voiceClips       VoiceClip[]
  leads            Lead[]
  connections      Connection[]
  posts            Post[]
  mediaFolders     MediaFolder[]
  mediaAssets      MediaAsset[]
  autopilot        AutopilotSettings?
  autopilotRuns    AutopilotRun[]
  dailyPostRuns    DailyPostRun[]
  imageConcepts    ImageConcept[]
  creatorCampaigns CreatorCampaign[]
  chatWidgets      ChatWidget[]
  chatSessions     ChatSession[]
  contacts         Contact[]
  contactTags      ContactTag[]
  contactFields    ContactField[]
  conversations    Conversation[]
  automations      Automation[]
  webhookEndpoints WebhookEndpoint[]
  apiKeys          ApiKey[]
  storeConnections StoreConnection[]
  pendingStores    StoreConnectionPending[]
  cloudflare       CloudflareConnection?
  memberships      Membership[]
  pushSubscriptions PushSubscription[]
  invites          Invite[]
  invoices         Invoice[]
  customPlans      PlanDefinition[]
  planOffers       PlanOffer[]
  planRequests     CustomPlanRequest[]
  personas         Persona[]
  competitors      Competitor[]
  faqs             KnowledgeFaq[]
  testimonials     Testimonial[]
  interview        MarketingInterview?
  postVersions     PostVersion[]
  videoJobs        VideoJob[]
  videoOutcomes    VideoOutcome[]
  studioTickets    StudioTicket[]
  bioPage          BioPage?

  @@index([industryId])
  // The sales staff member the company is assigned to (StaffMember.id), from a referral link at sign-up or a sales
  // manager's reassignment; null = unassigned (its revenue is the sales team's shared). History: ClientAssignment.
  salesAgentId            String?
  @@index([regionMismatchAt])
  @@index([salesAgentId])
}

// LEGACY, read-only since the Knowledge base (docs/KNOWLEDGE_BASE.md): what the business promoted before Products and
// Campaigns. Migration 20261013100000_knowledge_base copied every row into Product or Campaign with the SAME id, so an
// old projectId is still the id of its product or campaign. New code never writes here.
model Project {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type       String // "product" | "service" | "event" | "offer" | "listing" | "project" ...
  title      String // product name, address, event name...
  price      String? // free text: "$485,000", "10% off", "From $49"
  features   String[]
  details    Json? // type-specific fields (bedrooms, colors, dates...)
  photoPaths String[] // object paths in the private "media" bucket (<userId>/projects/...)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contents  GeneratedContent[]
  designs   Design[]
  posts     Post[]
  storeSync ProductSync?

  @@index([businessId, createdAt])
}

// Every generation is kept, so users can regenerate and compare versions.
// Belongs to one product or one campaign. projectId is the legacy link, kept readable.
model GeneratedContent {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  caption     String
  hashtags    String[]
  videoScript String
  adHeadlines String[]
  language    String    @default("English")
  // Per-network versions (caption length, hashtags, aspect ratio) prepared for publishing.
  variants    Json?
  edited      Boolean   @default(false) // true once the owner changed the AI's text
  // When its posts to review were drafted (lib/content-board/drafts.ts); null for content from before, which is drafted
  // once when its product or campaign is opened.
  postsDraftedAt DateTime?
  // Content packs (docs/CONTENT_PACKS.md): the posts written together share packId; each has its angle
  // (lib/studio/angles.ts) and the one app it is for. All null for content from before packs (one post for every app).
  packId      String?
  angle       String?
  network     String?
  // Content flow v3 (docs/CONTENT.md, lib/content-flow/): the business-local day a post was made for on the day view,
  // how it was made ("ai" | "describe" | "own") and the owner's brief or caption. Null on content from before.
  forDate     DateTime? @db.Date
  mode        String?
  brief       String?
  // The post's format as BuPulse decided it ("image" | "carousel" | "video", lib/content-flow/format.ts), so the next
  // days vary it per app. Null on content from before.
  format      String?
  provider    String // "gemini" | "claude" | "edit"
  model       String
  createdAt   DateTime  @default(now())
  visuals     ContentVisual[]
  videoJobs   VideoJob[]

  @@index([projectId, createdAt])
  @@index([productId, createdAt])
  @@index([campaignId, createdAt])
  @@index([businessId, createdAt])
  @@index([packId])
  @@index([businessId, forDate])
}

// ---- Knowledge base (docs/KNOWLEDGE_BASE.md) ----------------------------------------------------------------------

enum ProductKind {
  PHYSICAL
  DIGITAL
  SERVICE
}

enum PriceModel {
  FIXED
  FROM
  PER_MONTH
  PER_YEAR
  PER_UNIT
  ON_REQUEST
}

enum ItemStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum CampaignType {
  EVENT
  OFFER
  PROMOTION
  LAUNCH
  OTHER
}

// Something the business sells: a physical product, a digital product or a service.
model Product {
  id             String      @id @default(cuid())
  businessId     String
  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind           ProductKind
  name           String
  category       String?
  summary        String // short description, one or two sentences
  description    String?
  priceModel     PriceModel  @default(ON_REQUEST)
  priceAmount    Int? // in the currency's smallest unit (RWF has none: whole francs)
  currency       String // ISO 4217; the company's region currency unless the owner picked another
  priceNote      String? // extra price text ("Discount from 3 pieces"); also the free-text price of a migrated project
  usps           String[] // unique selling points: why buy this one
  features       String[]
  targetCustomer String?
  status         ItemStatus  @default(ACTIVE)
  details        Json? // kind-specific fields (lib/knowledge/products.ts productDetailsSchema)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  photos       ProductPhoto[]
  campaigns    CampaignProduct[]
  contents     GeneratedContent[]
  designs      Design[]
  posts        Post[]
  storeSync    ProductSync?
  testimonials Testimonial[]
  videoJobs    VideoJob[]
  bioItems     BioPageItem[]

  @@index([businessId, status, createdAt])
}

// An event, offer, promotion or launch, usually with dates and the products it is about.
model Campaign {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        CampaignType
  name        String
  description String?
  startsAt    DateTime?    @db.Date
  endsAt      DateTime?    @db.Date
  priceInfo   String? // "20% off", "Free entry", "Buy 2 get 1 free"
  highlights  String[]
  status      ItemStatus   @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  products CampaignProduct[]
  photos   CampaignPhoto[]
  contents GeneratedContent[]
  designs  Design[]
  posts    Post[]
  videoJobs VideoJob[]
  creatorCampaigns CreatorCampaign[]

  @@index([businessId, status, createdAt])
}

model CampaignProduct {
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([campaignId, productId])
  @@index([productId])
}

// A product's album: gallery photos linked to it. A photo can be in several albums; deleting a product keeps its photos.
model ProductPhoto {
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  assetId   String
  asset     MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position  Int        @default(0)
  createdAt DateTime   @default(now())

  @@id([productId, assetId])
  @@index([assetId])
}

model CampaignPhoto {
  campaignId String
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assetId    String
  asset      MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@id([campaignId, assetId])
  @@index([assetId])
}

// Knowledge base, part 2 (docs/KNOWLEDGE_BASE.md). A customer persona: who buys, what they need and how they decide.
model Persona {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String // "Busy office worker"
  ageRange   String // lib/knowledge/audience.ts AGE_RANGES
  gender     String? // optional: "female" | "male" | "any"
  location   String
  occupation String?
  incomeBand String? // "low" | "middle" | "high"
  needs      String[]
  pains      String[]
  objections String[]
  channels   String[] // where they spend time online
  triggers   String[] // what makes them buy now
  language   String? // preferred language
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, position])
}

model Competitor {
  id            String   @id @default(cuid())
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  link          String? // website or social profile, as typed (normalised to https:// or @handle)
  strengths     String[] // what they do well
  weaknesses    String[]
  pricePosition String? // "lower" | "similar" | "higher" | "varies"
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([businessId, position])
}

// The company's FAQs, in order. Replaces Business.knowledge.faqs (copied by the migration; the JSON stays for older builds).
model KnowledgeFaq {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  question   String
  answer     String
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, position])
}

enum ReviewSource {
  GOOGLE
  WHATSAPP
  IN_PERSON
  FACEBOOK
  INSTAGRAM
  EMAIL
  OTHER
}

// A customer review or testimonial. The AI may quote it only when canPublish is true (the customer agreed).
model Testimonial {
  id           String       @id @default(cuid())
  businessId   String
  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quote        String
  customerName String // name or initials, as the customer agreed to be shown
  source       ReviewSource
  rating       Int? // 1 to 5
  receivedOn   DateTime?    @db.Date
  productId    String?
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  canPublish   Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([businessId, createdAt])
  @@index([productId])
}

// The AI marketing interview in progress (one per company): its questions and answers, in order. The approved result
// is Business.marketingProfile (lib/knowledge/interview.ts).
model MarketingInterview {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status     String   @default("active") // active | review (summary written, waiting for approval) | approved
  mode       String   @default("ai") // ai (next question by the AI) | fixed (the fixed question set)
  steps      Json // InterviewStep[]
  cursor     Int      @default(0)
  aiCalls    Int      @default(0)
  summary    Json? // the draft brand-voice summary before approval
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  WON
  LOST
}

model Lead {
  id               String       @id @default(cuid())
  businessId       String
  business         Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name             String?
  email            String?
  phone            String?
  interest         String?
  message          String?
  source           String       @default("website_chat") // "website_chat", "instagram", "contact_form"
  status           LeadStatus   @default(NEW)
  notes            String?
  sessionId        String?      @unique // the chat it came from
  session          ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  pageUrl          String? // page the visitor was on
  contactId        String? // the contact this lead belongs to (docs/INBOX.md); set when the lead is saved
  contact          Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  notifiedAt       DateTime? // instant email sent
  webhookPendingAt DateTime? // set when the lead.created webhook failed; the hourly cron retries it for 24 hours
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([webhookPendingAt])
  @@index([contactId])
}

// The website chat widget's settings. Created on first visit to the widget settings page.
model ChatWidget {
  businessId             String    @id
  business               Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled                Boolean   @default(true)
  greeting               String? // first message; default is written in the business's content language
  position               String    @default("right") // "right" | "left"
  accentColor            String? // defaults to the first brand colour
  allowedDomains         String[] // hostnames the widget may run on; empty = not yet installed, any site allowed until set
  notifyInstant          Boolean   @default(true) // email the owner for every new lead
  notifyDaily            Boolean   @default(true) // daily summary email
  // WhatsApp alert for every new lead (lib/leads/whatsapp.ts). Only offered while the admin has the WhatsApp service on.
  notifyWhatsapp         Boolean   @default(false)
  whatsappNumber         String? // where the WhatsApp alerts go; empty = the business phone from sign-up
  webhookUrl             String? // POST lead.created events here (signed)
  webhookSecretEncrypted String? // HMAC secret, encrypted with lib/crypto.ts
  lastDigestAt           DateTime?
  lastSeenAt             DateTime? // the widget last loaded on a customer's site (written at most every 10 minutes)
  lastSeenHost           String? // hostname of that site
  disabledByAdminAt      DateTime? // set by the admin console (switch off the widget); the owner cannot turn it back on
  disabledByAdminReason  String?
  updatedAt              DateTime  @default(now()) @updatedAt
}

// A phone or browser that gets a push notification for every new lead (Web Push, lib/push). One person can have
// several; each is switched on from that device ("Alerts on this device" on the Leads page). Removed when the push
// service says it is gone (404/410), when the person turns it off, or with the person or the company.
model PushSubscription {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid // the person who switched it on (a teammate's own account, not the company's)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  device     String? // a short label from the browser, e.g. "Chrome on Android"
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([businessId])
  @@index([userId])
}

// One visitor conversation on a business's website.
model ChatSession {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visitorId     String // random id kept in the visitor's browser
  origin        String? // site hostname it ran on
  pageUrl       String?
  language      String? // detected visitor language
  messageCount  Int           @default(0)
  createdAt     DateTime      @default(now())
  lastMessageAt DateTime      @default(now())
  messages      ChatMessage[]
  lead          Lead?
  conversation  Conversation?

  @@index([businessId, lastMessageAt])
  @@index([businessId, visitorId])
  @@index([businessId, createdAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "visitor" | "assistant" | "system"
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// Payment providers BuPulse can bill through. Paddle first; others plug into lib/billing.
enum BillingProvider {
  PADDLE
  STRIPE
  PAYPAL
  // Mobile Money paid by hand and confirmed in the admin console (lib/billing/momo.ts). An automatic MoMo provider
  // (Paypack, Flutterwave, MTN) gets its own value and adapter later; see docs/MOMO.md.
  MANUAL_MOMO
}

enum BillingInterval {
  MONTH
  YEAR
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String             @unique @db.Uuid
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The plan key (PlanDefinition.key): TRIAL, STANDARD, PRO or any plan the admin creates.
  plan                   String             @default("TRIAL")
  planRef                PlanDefinition     @relation(fields: [plan], references: [key], onUpdate: Cascade, onDelete: Restrict)
  status                 SubscriptionStatus @default(TRIALING)
  provider               BillingProvider? // null while on the free trial
  providerCustomerId     String?
  providerSubscriptionId String?            @unique
  providerPriceId        String?
  interval               BillingInterval    @default(MONTH)
  cancelAtPeriodEnd      Boolean            @default(false) // stays active until currentPeriodEnd
  providerUpdatedAt      DateTime? // the provider's last change; older webhooks arriving late are ignored
  trialEndsAt            DateTime?
  // The plan chosen at sign-up (PlanDefinition.key, no foreign key so a plan can be retired freely). While the status is
  // PENDING_DEMO nothing is usable; during the trial the company has this plan's features with the TRIAL plan's limits;
  // `plan` becomes this key when the client pays.
  chosenPlan             String?
  // Trial-end reminders (lib/demo/trial-reminders.ts), recorded before sending so each goes out at most once.
  trialReminder1SentAt   DateTime?
  trialReminder2SentAt   DateTime?
  // Start of the billing period. Usage resets monthly from here (yearly plans too).
  currentPeriodStart     DateTime           @default(now())
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

// Every payment webhook received, for idempotency (providers retry) and auditing.
model BillingEvent {
  id          String          @id @default(cuid())
  provider    BillingProvider
  eventId     String // the provider's own event id
  type        String
  userId      String?         @db.Uuid
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime        @default(now())

  @@unique([provider, eventId])
  @@index([userId])
  // The sales room TV reads new payments every 10 s by time (lib/screen/data.ts).
  @@index([createdAt])
}

// One Mobile Money payment a client makes by hand (docs/MOMO.md). The client starts it (a reference to quote),
// pays on their phone, submits the transaction id and phone (submittedAt), and the owner confirms or rejects it in the
// admin console. Confirming writes the paid period onto the Subscription (periodStart/periodEnd kept here as the record).
// userId is the company account (Business.userId), like Subscription.
model ManualPayment {
  id            String          @id @default(cuid())
  userId        String          @db.Uuid
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey       String
  plan          PlanDefinition  @relation(fields: [planKey], references: [key], onUpdate: Cascade, onDelete: Restrict)
  interval      BillingInterval
  amountMinor   Int // RWF has no minor unit: whole francs
  currency      String          @default("RWF")
  // "BP-7K3Q": what the client types as the payment note; unambiguous characters. A payment of an invoice uses the
  // invoice number instead ("BP-INV-0001"), so several attempts at one invoice share it: uniqueness is two partial
  // indexes in SQL ("ManualPayment_reference_key" where the reference does not start with BP-INV-,
  // "ManualPayment_invoice_live_key").
  reference     String
  // The invoice this payment settles (docs/INVOICES.md); confirming it marks the invoice paid.
  invoiceId     String?
  invoice       Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // The custom plan offer this payment pays (docs/OFFERS.md); confirming it marks the offer paid and switches the
  // company onto the offer's custom plan (planKey). Null for plan, renewal and invoice payments.
  offerId       String?
  offer         PlanOffer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)
  payerPhone    String?
  network       String? // "MTN" | "AIRTEL"
  transactionId String? // the MoMo transaction id the client typed; null when they could not find it (the owner enters it on confirm)
  // The screenshot of the MoMo confirmation (docs/MOMO.md, "Proof"): an object in the private "payment-proofs" bucket
  // under <userId>/<paymentId>/. Set when the upload URL is issued, checked (size, first bytes) when the client submits;
  // proofBytes and proofType are filled only once it passed. Removed with an expired payment and with the account.
  proofPath     String?
  proofBytes    Int?
  proofType     String?
  // pending (started, or submitted and waiting for the owner) | confirmed | rejected | expired (not submitted in time, or replaced)
  status        String          @default("pending")
  rejectReason  String?
  submittedAt   DateTime? // when the client tapped "I've paid"
  decidedAt     DateTime?
  decidedBy     String? // AuditLog actor
  periodStart   DateTime? // the period this payment bought, set on confirm
  periodEnd     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  // Also two partial unique indexes in SQL (the migration): one pending payment per company
  // ("ManualPayment_one_pending_per_user") and one live use of a transaction id per network across all companies
  // ("ManualPayment_live_transaction_key": network + upper(transactionId) where status is pending or confirmed).

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([reference])
  @@index([invoiceId])
  @@index([offerId])
}

// A card renewal of a Mobile Money plan whose first card charge must be moved by the days already paid
// (lib/billing/carry-over.ts, docs/BILLING.md "Renewing"). Written before the provider is asked, so a failed request is
// retried by the daily renewals job and the admins are alerted; paid days are never lost silently.
model CardCarryOver {
  id                     String    @id @default(cuid())
  provider               String // BillingProvider of the card subscription
  providerSubscriptionId String    @unique
  userId                 String?   @db.Uuid
  nextBilledAt           DateTime // one period after the end of the days paid by Mobile Money
  status                 String    @default("pending") // pending | done | failed (gave up: credit by hand)
  attempts               Int       @default(0)
  lastError              String?
  alertedAt              DateTime?
  doneAt                 DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, createdAt])
}

// One renewal email of a Mobile Money subscription (lib/billing/momo-renewals.ts): "5d" and "1d" before the period
// ends, and "paused" when the grace period is over. The unique key is the claim, so a reminder is never sent twice.
model RenewalNotice {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodEnd DateTime
  kind      String // "5d" | "1d" | "paused"
  sentAt    DateTime @default(now())

  @@unique([userId, periodEnd, kind])
}

// One row per user per billing period. Limits per plan live in lib/plans.ts.
model UsageRecord {
  id               String   @id @default(cuid())
  userId           String   @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart      DateTime
  textGenerations  Int      @default(0)
  imageGenerations Int      @default(0)
  videos           Int      @default(0) // videos made this month (each up to 30 s; until 14 Oct 2026: seconds)
  voiceCharacters  Int      @default(0)
  chatMessages     Int      @default(0) // AI replies of the website chat widget
  videoCredits     Int      @default(0) // Video Studio credits used this month (lib/video-engine/credits.ts)
  updatedAt        DateTime @updatedAt

  @@unique([userId, periodStart])
}

// Videos made per day (Kigali day, lib/time/kigali.ts): at most the plan's videosPerDay (4 by default) a day, on top of
// the monthly count in UsageRecord.videos. A failed render counts nothing (lib/usage.ts consumeDailyVideo).
model VideoDayUsage {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // YYYY-MM-DD in Africa/Kigali
  videos    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, day])
}

// ---- Phase 2: performance learning (tables exist now so nothing needs reworking later) ----

enum ConnectionKind {
  SOCIAL
  APP
}

enum ConnectionMethod {
  DIRECT // BuPulse's own developer app and OAuth tokens
  OWN_COMPOSIO // the user's own Composio account (Pro)
  COMPOSIO // "BuPulse-Socials": BuPulse's own Composio account; the token stays at Composio (lib/social/composio)
}

// How posts reach the network: AUTO publishes through the API; NOTIFY (e.g. a personal Instagram
// account, which the API cannot post to) reminds the owner with everything ready to post by hand.
enum PostingMode {
  AUTO
  NOTIFY
}

enum ConnectionStatus {
  ACTIVE
  EXPIRING
  EXPIRED
  REVOKED
  ERROR
}

// A connected social account or app. Tokens are encrypted with lib/crypto.ts.
model Connection {
  id                         String           @id @default(cuid())
  businessId                 String
  business                   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind                       ConnectionKind
  provider                   String // "instagram" | "facebook" | "tiktok" | "linkedin" | "youtube" | "google_drive" | "dropbox" | "canva" | "shopify" | "woocommerce" | "cloudflare" ...
  method                     ConnectionMethod @default(DIRECT)
  externalAccountId          String
  displayName                String?
  accessTokenEncrypted       String?
  refreshTokenEncrypted      String?
  scopes                     String[]
  status                     ConnectionStatus @default(ACTIVE)
  expiresAt                  DateTime?
  lastCheckedAt              DateTime?
  composioConnectedAccountId String?
  postingMode                PostingMode      @default(AUTO)
  accountType                String? // network-specific, e.g. "business" | "creator" | "personal" | "page" | "organization"
  avatarUrl                  String?
  lastError                  String?
  inboxEnabled               Boolean          @default(false) // "Answer comments and messages" (Instagram, Facebook): docs/SOCIAL_INBOX.md
  inboxCursor                Json? // what the inbox check has seen so far (lib/social/inbox/cursor.ts)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  conversations              Conversation[]
  posts                      Post[]

  @@unique([businessId, provider, externalAccountId])
  @@index([status, expiresAt])
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL // made by Autopilot, waiting for the owner's OK
  SCHEDULED
  PUBLISHING // claimed by the publisher
  PUBLISHED
  NEEDS_ACTION // NOTIFY connections: the owner was reminded to post it by hand
  FAILED
  CANCELLED
}

enum PostFormat {
  POST // text with optional images (one network post)
  CAROUSEL // several images
  ARTICLE // long-form (LinkedIn)
  THREAD // reserved for X later
  SCRIPT // video script only until Stage 2 video (TikTok, Reels, YouTube)
}

enum PostSource {
  MANUAL
  AUTOPILOT
  STUDIO // drafted automatically from Studio content (lib/content-board/drafts.ts)
  DAILY // made by the nightly daily posts run (lib/daily-posts), shown as "Made for you this morning"
}

// One post for one connected account. Posts written together for several accounts share a groupId.
model Post {
  id             String        @id @default(cuid())
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  connectionId   String? // null for a draft without an account, or after the account was disconnected
  connection     Connection?   @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  network        String // "instagram" | "facebook" | "linkedin" | "tiktok" | "youtube"; kept if the connection goes
  groupId        String?
  projectId      String? // legacy; new posts set productId or campaignId
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentId      String? // GeneratedContent it came from
  status         PostStatus    @default(DRAFT)
  format         PostFormat    @default(POST)
  source         PostSource    @default(MANUAL)
  title          String? // ARTICLE title
  text           String        @default("")
  hashtags       String[]
  mediaPaths     String[] // storage object paths ("media" or "designs" bucket), in order
  link           String?
  scheduledAt    DateTime?
  publishedAt    DateTime?
  externalId     String?
  permalink      String?
  attempts       Int           @default(0)
  nextAttemptAt  DateTime?
  lockedAt       DateTime? // set while the publisher works on it; stale locks are retaken
  lastError      String?
  autopilotRunId String?
  autopilotRun   AutopilotRun? @relation(fields: [autopilotRunId], references: [id], onDelete: SetNull)
  playbookId     String? // the playbook idea Autopilot used, for learning what works
  // Why a post that could have been scheduled on its own still waits for review ("Video needs to be made").
  reviewNote     String?
  // Set when auto-approval (Content -> Settings) scheduled the post; the daily summary email lists these.
  autoScheduledAt DateTime?
  // Set when the owner changed the post (text, media, time, review state): BuPulse then never replaces or redraws it.
  ownerEditedAt  DateTime?
  // For an app that is not connected (yet): at its time the owner gets the reminder to post it by hand, like a NOTIFY
  // account (lib/publishing/engine.ts). False on posts that lost their account later: those fail as before.
  remindOnly     Boolean       @default(false)
  // A challenge or contest the AI suggested (lib/content-flow/contest.ts): {} until the owner confirms the prize, end
  // date and how the winner is chosen ({ prize, endsOn, howChosen, confirmedAt }). Never auto-approved.
  contest        Json?
  // "post" | "carousel" | "video" | "article": kept by a database trigger from format and mediaPaths, for the type filter.
  mediaKind      String        @default("post")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  metrics        PostMetrics[]
  versions       PostVersion[]
  videoOutcome   VideoOutcome?

  @@unique([connectionId, externalId])
  @@index([status, scheduledAt])
  @@index([businessId, scheduledAt])
  @@index([groupId])
  @@index([businessId, status, publishedAt])
  @@index([businessId, createdAt])
  @@index([businessId, autoScheduledAt])
}

// A post's words at each change (docs/CONTENT.md, "Versions"): its first text, every edit, every "Generate again" and
// every restore. Restoring adds a new version; none is overwritten. The newest 50 per post are kept.
model PostVersion {
  id             String   @id @default(cuid())
  businessId     String
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  postId         String
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind           String // "original" | "edit" | "regenerate" | "restore"
  part           String? // what "Generate again" wrote: "post" | "caption" | "script" | "headlines"
  restoredFromId String? // the version a restore brought back
  actorId        String?  @db.Uuid // the person who made the change; null for BuPulse's own text
  title          String?
  text           String
  hashtags       String[]
  // The post's content (GeneratedContent) pieces at that time: its video script and ad headlines.
  videoScript    String   @default("")
  adHeadlines    String[]
  // Each piece's language at that time: {caption, script, headlines} (lib/content-flow/versions.ts PartLanguages).
  // Null when not recorded: the pieces are in the content's language.
  languages      Json?
  createdAt      DateTime @default(now())

  @@index([postId, createdAt])
  @@index([businessId, createdAt])
}

model PostMetrics {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  capturedAt DateTime @default(now())
  views      Int?
  reach      Int?
  likes      Int?
  comments   Int?
  saves      Int?
  shares     Int?

  @@index([postId, capturedAt])
}

// Server-side errors, written by lib/errors.ts and read by the admin console and Jarvis.
model ErrorLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  level      String   @default("error") // "error" | "warn"
  source     String // route, job or module name
  message    String
  stack      String?
  userId     String?
  businessId String?
  context    Json?

  @@index([createdAt])
}

// Messages from the public site: contact form, done-for-you call requests and
// Meta data-deletion callbacks. Read by admins only (server-side).
model ContactRequest {
  id           String   @id @default(cuid())
  kind         String // "contact" | "done_for_you" | "meta_data_deletion"
  name         String
  email        String
  phone        String?
  businessName String?
  industry     String?
  message      String
  createdAt    DateTime @default(now())
  handled      Boolean  @default(false)

  @@index([kind, createdAt])
  @@index([email, createdAt])
}

enum DesignKind {
  TEMPLATE // a BuPulse layout filled with the brand's logo, colours, photo and text (free)
  AI // an image generated from a description (counts against the plan's image limit)
}

// A branded image, stored as a PNG in the private "designs" bucket.
model Design {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  projectId   String? // legacy; new designs set productId or campaignId
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  campaignId  String?
  campaign    Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  kind        DesignKind
  template    String? // template id from lib/designs/templates, for TEMPLATE
  prompt      String? // the description, for AI
  aspectRatio String // "1:1" | "4:5" | "9:16" | "16:9"
  path        String // <userId>/designs/<id>.png in the "designs" bucket
  width       Int
  height      Int
  createdAt   DateTime   @default(now())

  @@index([businessId, createdAt])
}

// AI cost ledger: one row per call to an AI provider, successful or not.
// The image, carousel or video that comes with a piece of content (docs/CONTENT_VISUALS.md). Studio content links
// by contentId; an Autopilot post group (Post.groupId) by groupId. Designs keep their own rows; a video is a file in
// the media bucket (<userId>/videos/<id>.mp4) whose size counts toward the company's media quota.
model ContentVisual {
  id         String            @id @default(cuid())
  businessId String
  business   Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contentId  String?
  content    GeneratedContent? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  groupId    String?
  kind       String // "image" | "carousel" | "video"
  status     String            @default("pending") // "pending" | "ready" | "failed"
  items      Json              @default("[]") // ordered [{ designId?, path }]
  plan       Json // ImagePlan or VideoPlan (lib/visuals/types.ts)
  bytes      Int               @default(0) // the video file, counted toward the media quota
  seconds    Int               @default(0) // the video's length, counted toward the plan's video seconds
  error      String?
  renderedAt DateTime?
  // A render in progress (lease, so two tabs cannot both pay for the same AI photo).
  renderingUntil  DateTime?
  // A video upload the server allowed and has not confirmed yet: counted toward the quotas until it expires.
  uploadPath      String?
  uploadBytes     Int       @default(0)
  uploadExpiresAt DateTime?
  // The video robot (docs/VIDEO_ROBOT.md): its job while it holds the render lease, and its failed renders (3 = left to the browser).
  robotJobId      String?   @unique
  robotAttempts   Int       @default(0)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([contentId])
  @@index([uploadExpiresAt])
  @@index([groupId])
  @@index([businessId, kind])
  @@index([kind, status, createdAt])
}

// A voiceover made by the text-to-speech provider (docs/VOICE_AND_MUSIC.md): the MP3 in the media bucket at
// <userId>/voice/<hash>.mp3, reused for the same text and voice (hash), counted toward the media quota.
model VoiceClip {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  hash       String // sha-256 of voice id, model, take and text
  voiceId    String
  // speaking: one render is asking the voice service now (others wait); ready: the file is stored; spoken: paid for
  // but not stored yet (the audio waits in pendingAudio, so a retry stores it instead of paying again); too_long: the
  // voice ran past 30 seconds (never spoken again).
  status     String   @default("ready")
  path       String? // voice/<businessId>/<hash>.mp3 in the media bucket, once stored
  pendingAudio Bytes?
  bytes      Int
  characters Int
  durationMs Int
  // Start and end of each spoken sentence in milliseconds, in order: [{ startMs, endMs }]
  timings    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  videoJobs  VideoJob[]

  @@unique([businessId, hash])
}

// The royalty-free music library (docs/VOICE_AND_MUSIC.md): tracks uploaded by the admin, with their licence.
model MusicTrack {
  id          String   @id @default(cuid())
  title       String
  moods       String[] // lib/music/tracks.ts MOODS
  bpm         Int?
  licence     String // licence name, e.g. "Pixabay Content License"
  sourceUrl   String
  attribution String // shown where the licence requires it
  path        String   @unique // <id>.<ext> in the public "music" bucket
  mimeType    String
  bytes       Int
  durationMs  Int?
  active      Boolean  @default(true)
  createdBy   String // AuditLog actor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model AiCall {
  id           String   @id @default(cuid())
  userId       String?  @db.Uuid
  businessId   String?
  feature      String // "content" | "regenerate" | "image" | "eval" ...
  provider     String // "gemini" | "claude"
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  images       Int      @default(0)
  costUsd      Decimal  @default(0) @db.Decimal(12, 6) // estimated from lib/ai/pricing.ts
  // True when the provider never reported usage (a call that timed out on our side but was still billed) and the
  // tokens or images are our estimate (docs/AI_COSTS.md).
  estimated    Boolean  @default(false)
  durationMs   Int      @default(0)
  success      Boolean
  error        String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([businessId, createdAt])
}

// Fixed-window rate limits (lib/rate-limit.ts): one row per key and window, e.g.
// "design:<userId>" for the current hour.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

// The user's linked Canva account ("Edit in Canva", docs/CANVA.md). Tokens are AES-GCM encrypted
// with ENCRYPTION_KEY (lib/crypto.ts). One per user.
model CanvaConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  expiresAt             DateTime
  canvaUserId           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// One open Canva editing session. `id` is the random correlation state sent to Canva (max 50 chars)
// and comes back in the return-navigation token. Kept until it is pruned (2 days) so "Return to BuPulse" can be pressed again.
model CanvaEdit {
  id            String    @id
  userId        String    @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  designId      String
  canvaDesignId String
  processingAt  DateTime? // set while a return is being saved; stops two returns saving at once (stale after 2 min)
  createdAt     DateTime  @default(now())

  @@index([createdAt])
}

// The business's own photos ("Gallery"), loose or in folders, stored in the "media" bucket.
model MediaFolder {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime     @default(now())
  assets     MediaAsset[]

  @@unique([businessId, name])
}

// A Gallery video upload the server allowed and has not confirmed yet (docs/MEDIA.md): its signed upload token is tied
// to this row, its bytes count toward the quotas until it expires, and finalize takes only a reserved path.
model MediaUploadReservation {
  id         String   @id @default(cuid())
  businessId String
  path       String   @unique // <userId>/clips/<id>.<ext> in the gallery-videos bucket
  bytes      Int // the announced size, the most finalize accepts
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([businessId, expiresAt])
}

model MediaAsset {
  id         String          @id @default(cuid())
  businessId String
  business   Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  folderId   String? // null = not in a folder
  folder     MediaFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  path       String          @unique // <userId>/gallery/<id>.<ext> in the "media" bucket
  name       String
  // "photo" or "video" (docs/MEDIA.md). A video's poster is <id>-poster.jpg next to it; bytes include the poster.
  kind       String          @default("photo")
  mimeType   String
  bytes      Int
  width      Int?
  height     Int?
  durationMs Int?
  posterPath String?
  // The owner's "What's in this video?" (or photo): the AI writes captions about it.
  description String?
  source     String? // where an import came from: "google_drive" | "dropbox" | "canva" | "store"; null for uploads
  // A product photo's cut-out (lib/video-engine/cutout.ts): the PNG next to it and the product's box in it, or why it
  // cannot be cut out (then it is not tried again).
  cutoutPath    String?
  cutoutBox     Json?
  cutoutRefused String?
  createdAt  DateTime        @default(now())
  products   ProductPhoto[]
  campaigns  CampaignPhoto[]

  @@index([businessId, folderId, createdAt])
}

// Autopilot: AI plans and writes next week's posts. Off until the owner turns it on.
model AutopilotSettings {
  businessId            String   @id
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled               Boolean  @default(false)
  autoPublish           Boolean  @default(false) // false: posts wait as PENDING_APPROVAL for "Approve all"
  postsPerWeek          Int      @default(3)
  connectionIds         String[] // accounts Autopilot writes for
  postingTimes          String[] @default(["09:00", "18:00"]) // local times (Business.timezone) it may use
  useAiImages           Boolean  @default(true) // AI photos with people (image credits); false: gallery photos and free templates only
  skipReligiousHolidays Boolean  @default(false) // true: no greetings or posts for religious holidays
  videoQuality          String   @default("simple") // simple | mix | ai: AI clips in its videos (lib/visuals/video-quality.ts)
  updatedAt             DateTime @updatedAt
}

model AutopilotRun {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekStart  DateTime // Monday 00:00 in the business's time zone, stored as UTC
  status     String   @default("RUNNING") // RUNNING | DONE | FAILED
  postCount  Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())
  posts      Post[]

  @@unique([businessId, weekStart])
}

// Daily posts (docs/CONTENT.md "Daily posts", lib/daily-posts/service.ts): one row per company and business-local day,
// claimed by the nightly cron (unique, so calling it twice is safe). RUNNING until the day's posts are made; DONE with
// how many; SKIPPED with the reason (allowance, ai_allowance, budget, full, nothing); FAILED is retaken (a few times).
// The subject and ideas rotate from these rows; notifiedAt is the morning "Your posts for today are ready" notice.
model DailyPostRun {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  day         DateTime  @db.Date
  status      String    @default("RUNNING") // RUNNING | DONE | SKIPPED | FAILED
  attempts    Int       @default(1)
  posts       Int       @default(0)
  subjectKind String? // product | campaign | general
  subjectId   String?
  angles      String[]
  reason      String?
  note        String?
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([businessId, day])
  @@index([day, status])
}

// The image engine's memory (docs/IMAGE_ENGINE.md, lib/image-engine): one row per picture idea. The Director reads
// the recent rows so a company never gets the same idea twice; the batch's pictures are painted one step at a time from
// these rows (planned -> painting -> done | failed). Credits are reserved when the batch is planned (creditPeriod) and
// given back for a picture that fails.
model ImageConcept {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  batchId       String
  source        String // designs | content | daily | autopilot
  subjectId     String? // the product or campaign
  pattern       String // lib/image-engine/patterns.ts
  shot          String
  light         String
  layout        String
  camera        String    @default("") // the camera and medium it is shot on (lib/image-engine/realism.ts CAMERAS)
  treatment     String // exact | scale | line
  title         String
  scene         String
  headline      String
  subline       String
  cta           String
  prompt        String // the Prompter's image prompt for this picture
  planner       String // which AI wrote it: gemini | claude
  photoPath     String? // the product photo given to the Painter
  tier          String // lite | pro
  aspectRatio   String
  credits       Int
  creditPeriod  DateTime? // the usage period the credits were reserved in
  status        String    @default("planned") // planned | painting | done | failed
  paintingUntil DateTime?
  designId      String?
  path          String?
  caption       String?
  check         Json? // the Checker's verdict
  fixed         Boolean   @default(false) // the Editor fixed it once after the check
  rating        Int? // 1 liked, -1 disliked
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([businessId, createdAt])
  @@index([batchId])
}

// Outgoing webhooks (Phase 7), on every plan. One business can have a few endpoints, each with its own
// signing secret and the events it wants.
model WebhookEndpoint {
  id                  String            @id @default(cuid())
  businessId          String
  business            Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  url                 String
  events              String[] // lead.created, content.generated, post.published, post.failed
  secretEncrypted     String // HMAC secret, encrypted with lib/crypto.ts
  enabled             Boolean           @default(true)
  createdAt           DateTime          @default(now())
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  failureCount        Int               @default(0) // failed deliveries in a row; reset by a success
  pausedByAdminAt     DateTime? // set by the admin console; the owner cannot turn the webhook back on
  pausedByAdminReason String?
  deliveries          WebhookDelivery[]

  @@index([businessId])
}

// One event for one endpoint. pending: waiting for (another) attempt; success; failed: gave up or not retryable.
// Deleted after 30 days.
model WebhookDelivery {
  id             String          @id @default(cuid())
  endpointId     String
  endpoint       WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event          String
  payload        Json
  status         String          @default("pending")
  attempts       Int             @default(0)
  responseStatus Int?
  error          String?
  nextAttemptAt  DateTime?
  createdAt      DateTime        @default(now())

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([createdAt])
}

// Pro plan REST API keys (bp_live_...). Only a peppered hash (HMAC-SHA256, lib/api/keys.ts) is stored; the key is shown once.
model ApiKey {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  prefix     String // first characters of the key, to recognise it in the list
  hash       String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([businessId])
}

// Phase 7 commerce connectors (docs/CONNECTORS.md). A connected Shopify or WooCommerce store.
// `credentialsEncrypted` is lib/crypto.ts output: the Shopify access token, or WooCommerce "consumerKey:consumerSecret".
model StoreConnection {
  id                   String        @id @default(cuid())
  businessId           String
  business             Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider             String // "shopify" | "woocommerce"
  storeUrl             String // Shopify: "shop.myshopify.com"; WooCommerce: "https://store.com" (no trailing slash)
  credentialsEncrypted String
  scopes               String?
  currency             String? // WooCommerce store currency symbol/code, read once
  status               String        @default("ACTIVE") // "ACTIVE" | "NEEDS_ATTENTION"
  lastSyncAt           DateTime?
  lastSyncError        String?
  lastAttemptAt        DateTime? // last time the daily sync tried this store (fair rotation); null = never
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  products             ProductSync[]

  @@unique([businessId, provider])
  @@index([provider, storeUrl])
  @@index([lastAttemptAt])
}

// Maps one store product to one Product so a re-sync updates instead of duplicating.
// `baseline` holds the fields as the last sync wrote them: a Product field is only overwritten
// while it still equals its baseline (the user has not edited it). See lib/stores/sync.ts.
model ProductSync {
  id            String          @id @default(cuid())
  connectionId  String
  connection    StoreConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  productId     String?         @unique // null only for a mapping an older build wrote after the migration
  product       Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  projectId     String?         @unique // legacy
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  externalId    String
  baseline      Json
  imageMap      Json // { "<source image url>": "<storage path>" }
  lastSyncedAt  DateTime        @default(now())
  sourceMissing Boolean         @default(false)
  createdAt     DateTime        @default(now())

  @@unique([connectionId, externalId])
}

// A Cloudflare API token (pasted by the user, encrypted) and the chat-widget installs made with it.
model CloudflareConnection {
  businessId     String              @id
  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tokenEncrypted String
  status         String              @default("ACTIVE") // "ACTIVE" | "NEEDS_ATTENTION"
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  installs       CloudflareInstall[]
}

model CloudflareInstall {
  id          String               @id @default(cuid())
  businessId  String
  connection  CloudflareConnection @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  zoneId      String
  zoneName    String
  toolId      String // the Zaraz tool id BuPulse created
  installedAt DateTime             @default(now())

  @@unique([businessId, zoneId])
}

// WooCommerce keys that arrived at the callback but are not active until the signed-in owner confirms them.
model StoreConnectionPending {
  id                   String   @id @default(cuid())
  businessId           String
  business             Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider             String
  storeUrl             String
  credentialsEncrypted String
  currency             String?
  expiresAt            DateTime
  createdAt            DateTime @default(now())

  @@unique([businessId, provider])
}

// ---- Phase 8: BuPulse's own analytics (lib/analytics/*). Owner-only; read through /admin and Jarvis. ----

// One marketing-page view from public/t.js. No raw IP is stored: visitorHash is SHA-256(IP + UA + daily salt).
model PageView {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  sessionId    String? // random id from the visitor's sessionStorage
  visitorHash  String // changes every UTC day, so it never follows a person across days
  path         String
  referrerHost String?
  source       String // "direct" | "google" | "facebook" ... | utm_source
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  device       String // "mobile" | "tablet" | "desktop"
  country      String? // ISO 3166 alpha-2
  screenWidth  Int?

  @@index([createdAt])
  @@index([sessionId])
}

// A product event (signup, onboarding_step, generation ...). Written by lib/analytics/events.ts trackEvent.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  name       String
  userId     String?  @db.Uuid
  businessId String?
  sessionId  String? // the anonymous visit session, set on signup so the visit can be linked
  props      Json?

  @@index([name, createdAt])
  @@index([userId, createdAt])
  @@index([businessId, createdAt])
  @@index([createdAt])
}

// One number per day, key and dimension (e.g. key "visits", dimension "" or "page:/pricing"). Written by the daily roll-up.
model DailyMetric {
  date      DateTime @db.Date
  key       String
  dimension String   @default("")
  value     Float
  updatedAt DateTime @updatedAt

  @@id([date, key, dimension])
  @@index([key, date])
}

// Costs the owner enters by hand (email, hosting ...). month is "YYYY-MM".
model MonthlyCost {
  id          String   @id @default(cuid())
  month       String
  category    String
  amountCents Int
  note        String?
  updatedAt   DateTime @updatedAt

  @@unique([month, category])
}

// A cost that repeats (Admin -> Money -> Costs, docs/ADMIN.md): hosting, the domain, a subscription. Counted in every
// month from startMonth to endMonth (inclusive; null = still running); a yearly cost counts a twelfth each month.
// amountMinor is in `currency` (USD or RWF), converted to USD with the current rate when shown.
model RecurringCost {
  id          String   @id @default(cuid())
  name        String
  provider    String // a preset key (lib/money/costs-shared.ts COST_PRESETS) or "other"
  category    String // hosting | domain | ai | email | tools | other
  amountMinor Int
  currency    String   @default("USD")
  // RWF per USD when an RWF cost was saved: its months keep that rate, so changing the rate in Settings never restates
  // past costs. Null for USD.
  usdRate     Float?
  period      String // month | year
  startMonth  String // "YYYY-MM"
  endMonth    String?
  note        String?
  updatedBy   String? // AuditLog actor of the last change
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startMonth])
}

// What a provider really billed for one month (its invoice), entered by the admin. When present it replaces the
// ledger's estimate for that provider and month in every cost and profit number (lib/money/costs-shared.ts).
model ProviderBill {
  id          String   @id @default(cuid())
  provider    String // google_ai | anthropic | elevenlabs | higgsfield | other provider keys
  month       String // "YYYY-MM"
  amountMinor Int
  currency    String   @default("USD")
  usdCents    Int // amountMinor in USD cents at the rate of the day it was entered
  usdRate     Float? // RWF per USD used for an RWF bill
  note        String?
  enteredBy   String? // AuditLog actor
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, month])
}

// ---- Organisation: staff, roles, referrals, the sales screen (docs/ADMIN.md, "Organisation") ----------------------

// A person who works in the admin console besides the owner (ADMIN_EMAILS is always Owner). Signs in with their own
// account (Google or password) plus an authenticator (AAL2), like the owner; every page and action checks the role's
// permissions (lib/staff/permissions.ts). userId is linked on the first sign-in.
model StaffMember {
  id           String    @id @default(cuid())
  email        String    @unique // lower case
  name         String?
  phone        String?
  userId       String?   @unique @db.Uuid
  roleKey      String // a built-in role (lib/staff/permissions.ts BUILT_IN_ROLES) or StaffRole.key
  status       String    @default("invited") // invited | active | disabled
  // The referral code of sales staff (?ref=CODE on any page): 4 to 8 unambiguous characters.
  refCode      String?   @unique
  invitedBy    String // AuditLog actor
  lastSignInAt DateTime?
  disabledAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

// A role the owner (or IT) made: a name and ticked permissions. Built-in roles are code, not rows.
model StaffRole {
  id          String   @id @default(cuid())
  key         String   @unique // "custom_<slug>"
  name        String
  permissions String[]
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Which sales staff member a company belonged to, and when: payments count for the agent assigned on the payment's
// date, so a reassignment never moves past payments. staffId null = unassigned (team share). No foreign keys: the
// history outlives a deleted company or staff member. userId is the company account (Business.userId, BillingEvent.userId).
model ClientAssignment {
  id         String    @id @default(cuid())
  businessId String
  userId     String    @db.Uuid
  staffId    String?
  startsAt   DateTime
  endsAt     DateTime?
  source     String // referral | manager | script
  reason     String?
  by         String // AuditLog actor, or "referral"
  createdAt  DateTime  @default(now())

  @@index([businessId, startsAt])
  @@index([userId, startsAt])
  @@index([staffId, startsAt])
}

// A view-only link to the sales room TV (/screen/<token>). Only the token's SHA-256 is stored; revoking stops it at once.
model ScreenLink {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  createdBy  String
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastSeenAt DateTime?
}

// A celebration sound for the sales screen: uploaded by the owner (their rights) or generated with ElevenLabs Sound
// Effects. The MP3 is in the private "sounds" Storage bucket at `path`. At most 10 active.
model SoundClip {
  id         String   @id @default(cuid())
  name       String
  path       String   @unique
  source     String // upload | generated
  prompt     String?
  bytes      Int
  durationMs Int?
  active     Boolean  @default(true)
  createdBy  String
  createdAt  DateTime @default(now())

  @@index([active])
}

// A version of the web app uploaded as a signed zip (Admin -> Settings -> Updates, docs/UPDATES.md "Install from a
// zip"). The zip and the database backup taken before its migrations live in the private "releases" Storage bucket
// and are kept 30 days (always the current and the previous installed version). The deploy workflow writes back the
// install's outcome (status, Cloudflare version id, backup path).
model ReleaseVersion {
  id                  String    @id @default(cuid())
  version             String
  commit              String
  sha256              String
  size                Int
  zipPath             String // zips/<uuid>.zip in the "releases" bucket (kept as a record after zipPurgedAt)
  zipPurgedAt         DateTime?
  manifest            Json // the signed manifest and its signature, as uploaded
  notes               String?
  // verified -> installing -> installed (or failed); superseded once a newer version is installed
  status              String    @default("verified")
  uploadedBy          String // AuditLog actor
  installRequestedAt  DateTime?
  installRequestedBy  String?
  installedAt         DateTime?
  cloudflareVersionId String?
  backupPath          String? // backups/<id>.dump in the "releases" bucket
  backupPurgedAt      DateTime?
  error               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([createdAt])
  @@index([status, installedAt])
}

// ---- Phase 8: admin console and Jarvis (lib/admin/*, docs/JARVIS.md) ----

// Append-only record of every admin action. actor is "admin" (the console) or "jarvis:<AdminApiKey id>".
model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String? // e.g. "user:<id>", "flag:<key>", "approval:<id>"
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([target])
}

// A money action (refund, change to a paid plan) waiting for the owner's click in the console.
// Jarvis and the API can only create these. idempotencyKey makes a repeated request return the same row.
model AdminApproval {
  id             String    @id @default(cuid())
  kind           String // "issue_refund" | "change_plan"
  params         Json
  status         String    @default("pending") // pending | approved | rejected | executed | failed
  requestedBy    String
  idempotencyKey String    @unique
  result         Json?
  decidedBy      String?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
}

// Bearer keys for the Jarvis REST API and MCP server. Only a peppered hash (HMAC-SHA256, lib/api/keys.ts) is stored.
model AdminApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  hash        String    @unique
  ipAllowList String[] // empty = any address
  // A key made by a staff member (not the owner) is scoped: it may run only the tools its permissions allow, and only
  // while that person is enabled and still holds them (lib/admin/api-auth.ts). An owner's key has every permission.
  scoped           Boolean  @default(false)
  permissions      String[] @default([])
  createdByStaffId String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model FeatureFlag {
  key            String   @id
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(100) // 0-100, applied per user by a stable hash when enabled
  userOverrides  Json? // { "<userId>": true | false }
  description    String?
  updatedAt      DateTime @updatedAt
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  audience    String    @default("all") // "all" | "plan"
  plans       String[] // plan keys; used when audience = "plan"
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  dismissible Boolean   @default(true)
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([startsAt, endsAt])
}

// The random key behind one UTC day's visitor hashes (lib/analytics/salt.ts). Deleted once the day has ended,
// so yesterday's hashes can no longer be recomputed from an IP and browser.
model AnalyticsSalt {
  day       String   @id // "YYYY-MM-DD"
  salt      String
  createdAt DateTime @default(now())
}

// One finished run of a scheduled job (lib/admin/cron-run.ts). Read by the admin health page; old rows are pruned.
model CronRun {
  id         String   @id @default(cuid())
  job        String
  startedAt  DateTime
  finishedAt DateTime
  ok         Boolean
  summary    String?
  error      String?

  @@index([job, startedAt])
  @@index([startedAt])
}

// A private note about a client, written in the admin console. userId has no foreign key on purpose (see the migration).
model AdminNote {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  body      String
  createdBy String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---- Admin: services control and AI budget (lib/admin/services.ts, lib/admin/switch.ts) ----

// Kill switch per outside service. A missing row means "on". reason is what the owner typed.
model ServiceSwitch {
  service   String   @id
  enabled   Boolean  @default(true)
  reason    String?
  changedBy String
  updatedAt DateTime @updatedAt
}

// Result of the last "Test now" per service (secrets scrubbed before saving).
model ServiceCheck {
  service   String   @id
  ok        Boolean
  latencyMs Int
  message   String?
  checkedAt DateTime @default(now())
}

// Small counters per service and UTC day (e.g. emails sent through Resend).
model ServiceUsage {
  service String
  day     DateTime @db.Date
  ok      Int      @default(0)
  failed  Int      @default(0)

  @@id([service, day])
}

// Admin-changeable settings, e.g. key "ai.monthlyBudgetUsd" (overrides AI_MONTHLY_BUDGET_USD).
model AdminSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// A plan the admin manages (/admin/plans). Replaces the hard-coded plans of lib/plans.ts, whose values remain only as the
// seed and as the fallback when the database cannot be read. Paddle prices are never edited in place: a price change
// creates new Paddle prices and the old ids move to paddlePrices (history), so old subscriptions still map to this plan.
model PlanDefinition {
  id                   String    @id @default(cuid())
  key                  String    @unique // slug; TRIAL, STANDARD and PRO keep their old enum names
  name                 String
  description          String    @default("")
  isTrial              Boolean   @default(false) // exactly one plan: TRIAL
  trialDays            Int? // trial only
  status               String    @default("active") // active | hidden | retired
  sortOrder            Int       @default(0)
  highlight            Boolean   @default(false)
  monthlyPriceCents    Int       @default(0)
  yearlyPriceCents     Int       @default(0)
  currency             String    @default("USD")
  limits               Json // { text, image, chat, videos, videosPerDay, voiceCharacters, seats }
  // string[] marketing bullets on the pricing card (replaced `features` in 20261009110000_plan_features).
  highlights           Json      @default("[]")
  // FeatureKey[] (lib/features.ts): what the plan unlocks, prerequisites included. The source of truth for entitlements.
  // NULL (a row written by a build from before 20261009110000_plan_features) reads as the core features plus `capabilities`.
  featureKeys          Json?
  // Legacy columns, written in step with the two above so a build from before the migration keeps working:
  // `features` holds the same bullets as `highlights`; `capabilities` is { apiAccess, ownComposio } derived from featureKeys.
  features             Json
  capabilities         Json
  // The monthly AI allowance of a company on this plan, in USD (lib/ai/budget.ts); NULL uses AI_COMPANY_MONTHLY_USD.
  aiMonthlyUsd         Float?
  paddleProductId      String?
  paddleMonthlyPriceId String?
  paddleYearlyPriceId  String?
  // Every Paddle price this plan has had: [{ id, interval, amountCents, createdAt, archivedAt? }]. The current ones are in here too.
  paddlePrices         Json      @default("[]")
  // "not_synced" (draft or Paddle not connected) | "synced" | "failed"
  syncState            String    @default("not_synced")
  syncError            String?
  // A company's private plan, made from an accepted offer (docs/OFFERS.md). Never on the pricing page or in the plan
  // pickers (status "hidden" and filtered by isCustom); priced in its own currency (RWF in Rwanda), so Mobile Money
  // renewals charge what the offer said. A newer paid offer retires the older custom plan of the same company.
  isCustom             Boolean   @default(false)
  businessId           String?
  business             Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  subscriptions  Subscription[]
  priceChanges   PlanPriceChange[]
  regionPrices   PlanRegionPrice[]
  manualPayments ManualPayment[]

  @@index([businessId])
}

// ---- Regions, regional prices and demo bookings (docs/REGIONS.md) ---------------------------------------------------

// Where a business is, for prices and payment methods. RW, EAC and GLOBAL are seeded; admins can add more.
model PricingRegion {
  key            String   @id // "RW", "EAC", "GLOBAL" or an admin-created key
  name           String
  currency       String // ISO 4217: "RWF", "USD"
  countries      String[] // ISO 3166-1 alpha-2 codes; GLOBAL has none and takes everything else
  paymentMethods String[] // "momo" | "card"
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prices PlanRegionPrice[]
}

// A plan is offered in a region only when it has a price there. Amounts are in the currency's smallest unit
// (RWF has no minor unit, so monthlyMinor = whole francs). For a non-USD region the card (Paddle, USD) price is derived
// from the admin's USD rate and card margin and kept here; the Paddle price ids are filled by the (TODO) Paddle sync.
model PlanRegionPrice {
  id                   String         @id @default(cuid())
  planKey              String
  plan                 PlanDefinition @relation(fields: [planKey], references: [key], onUpdate: Cascade, onDelete: Cascade)
  regionKey            String
  region               PricingRegion  @relation(fields: [regionKey], references: [key], onUpdate: Cascade, onDelete: Cascade)
  currency             String
  monthlyMinor         Int
  yearlyMinor          Int
  cardMonthlyUsdCents  Int?
  cardYearlyUsdCents   Int?
  paddleMonthlyPriceId String?
  paddleYearlyPriceId  String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([planKey, regionKey])
  @@index([regionKey])
}

// When the owner takes demo calls: one row per weekly window, in Africa/Kigali time (lib/demo/slots.ts). Slot length,
// buffer and blocked dates are AdminSetting keys (lib/admin/settings.ts).
model AdminAvailability {
  id          String   @id @default(cuid())
  weekday     Int // 0 = Sunday ... 6 = Saturday
  startMinute Int // minutes after midnight, Africa/Kigali
  endMinute   Int
  createdAt   DateTime @default(now())

  @@index([weekday])
}

// A call with the owner, on the same slots, buffers, daily cap and calendar: the demo a new client books before its
// trial (kind "demo"), or a short call about a custom plan request from an existing client (kind "custom_plan",
// lib/demo/plan-calls.ts; never part of the PENDING_DEMO -> trial steps). One live ("booked") booking per start time,
// and one per company and kind (partial unique indexes in the migrations). A reschedule updates the row in place (same
// UID, SEQUENCE + 1).
model DemoBooking {
  id                  String             @id @default(cuid())
  businessId          String
  business            Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind                String             @default("demo") // demo | custom_plan
  requestId           String? // the custom plan request a custom_plan call was booked from
  request             CustomPlanRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  planKey             String // the plan chosen when booking (a call: the company's plan at the time)
  startsAt            DateTime
  endsAt              DateTime
  status              String             @default("booked") // booked | done | no_show | cancelled
  notes               String?
  meetingLink         String? // the reusable meeting link at the time of booking
  icsToken            String             @unique // 32 random bytes, base64url (lib/demo/bookings.ts newIcsToken): the secret of the .ics route
  sequence            Int                @default(0) // iCalendar SEQUENCE: bumped on every reschedule and on cancel, so calendars move the same event
  googleEventId       String? // the event in the owner's Google Calendar (lib/google-calendar), when it was connected at booking time
  meetLink            String? // the Google Meet link Google generated for that event (also copied into meetingLink)
  googleSyncPending   Boolean            @default(false) // a change to the booking has not reached the Google event yet (retried: lib/google-calendar/events.ts)
  googleSyncError     String? // why the last attempt failed, shown on Admin -> Demos
  googleSyncAttemptAt DateTime? // the last attempt, so retries are spaced out
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([startsAt])
  @@index([businessId, status])
  @@index([requestId])
}

// One price change of one plan. Existing subscribers move to the new price at a renewal, after notice (increase).
model PlanPriceChange {
  id                String         @id @default(cuid())
  planKey           String
  plan              PlanDefinition @relation(fields: [planKey], references: [key], onUpdate: Cascade, onDelete: Restrict)
  direction         String // increase | decrease | mixed
  oldMonthlyCents   Int
  newMonthlyCents   Int
  oldYearlyCents    Int
  newYearlyCents    Int
  oldMonthlyPriceId String?
  oldYearlyPriceId  String?
  newMonthlyPriceId String?
  newYearlyPriceId  String?
  // scheduled (waiting for notices and renewals) | completed | cancelled
  status            String         @default("scheduled")
  subscribers       Int            @default(0)
  notifiedCount     Int            @default(0)
  appliedCount      Int            @default(0)
  failedCount       Int            @default(0)
  createdBy         String
  createdAt         DateTime       @default(now())
  completedAt       DateTime?

  items PlanPriceChangeItem[]

  @@index([planKey, createdAt])
  @@index([status])
}

// One subscriber of a price change: notified, then moved to the new price shortly before the renewal on effectiveAt.
model PlanPriceChangeItem {
  id                     String          @id @default(cuid())
  changeId               String
  change                 PlanPriceChange @relation(fields: [changeId], references: [id], onDelete: Cascade)
  userId                 String          @db.Uuid
  providerSubscriptionId String
  interval               BillingInterval
  oldPriceId             String
  newPriceId             String
  oldCents               Int
  newCents               Int
  // pending -> notified (increase only) -> applied | skipped | failed
  status                 String          @default("pending")
  noticeSentAt           DateTime?
  reminderSentAt         DateTime? // the second email, about 30 days before the renewal, for notices sent long ahead
  attempts               Int             @default(0) // failed tries to send the notice; the item is failed after a few
  effectiveAt            DateTime? // the renewal the new price starts with
  appliedAt              DateTime?
  error                  String?
  updatedAt              DateTime        @updatedAt

  @@unique([changeId, userId])
  @@index([changeId, status])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

// Who belongs to a company. A user belongs to one company in Stage 1 (userId is unique). Business.userId stays the
// company account: the billing account, the Storage folder and the subject of every service call. The Owner role normally
// sits on that user; transferring ownership moves the role, not the account (see lib/team/service.ts).
model Membership {
  id          String     @id @default(cuid())
  businessId  String
  business    Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String     @unique @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        MemberRole
  invitedBy   String?    @db.Uuid
  /// Admins opt in to the lead, digest and post alerts that go to the Owner.
  notifyEmail Boolean    @default(false)
  createdAt   DateTime   @default(now())
  // Also a partial unique index in SQL ("Membership_one_owner_per_business"): one OWNER per business.

  @@index([businessId])
}

// A pending invitation. The token is emailed once; only its SHA-256 hash is stored.
model Invite {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  email      String
  role       MemberRole
  tokenHash  String     @unique
  invitedBy  String?    @db.Uuid
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([businessId])
  @@index([email])
}

// A business sector offered at sign-up, with the guidance the AI writes from (Admin -> Industries, docs/INDUSTRIES.md).
// The marketing /industries page keeps its own static list (lib/content/site.ts); the migration seeds the same names.
model Industry {
  id               String   @id @default(cuid())
  slug             String   @unique // stable form value, e.g. "retail"
  name             String // "Shops & retail"
  shortDescription String
  customers        String // typical customers
  offerings        String // typical products and services
  postIdeas        String // post ideas that work for this sector
  tone             String // tone of voice
  hashtags         String[]
  seasons          String // important dates and seasons in Rwanda / East Africa
  avoid            String // words, claims and compliance notes to avoid
  active           Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  businesses Business[]
}

// "New from sign-ups" suggestions the admin dismissed: the normalised (trimmed, lower-cased) industryOther text.
model DismissedIndustrySuggestion {
  key       String   @id
  label     String // the text as one client wrote it, for the audit log and the list
  createdAt DateTime @default(now())
}

// Invoices (docs/INVOICES.md): made by an admin, mostly from "Activate account -> No trial, send invoice" after the
// demo, edited while a draft, then sent (PDF by email), paid (Mobile Money confirmed with the invoice number as the
// reference, card, or marked paid by hand) or voided. Amounts are in the currency's smallest unit like everywhere else.
model Invoice {
  id             String           @id @default(cuid())
  // "BP-INV-0001": from the Postgres sequence "Invoice_number_seq" (lib/invoices/service.ts nextInvoiceNumber), so
  // two admins creating invoices at the same instant never get the same number. Numbers are never reused.
  number         String           @unique
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status         String           @default("draft") // draft | sent | paid | void
  currency       String // RWF for Rwanda, USD otherwise (the company region's currency)
  lines          Json // [{ description, quantity, unitMinor }]
  subtotalMinor  Int
  taxRatePercent Float? // VAT rate from the invoice settings when the invoice was last edited; null = no tax line
  taxMinor       Int              @default(0)
  totalMinor     Int
  issueDate      DateTime         @db.Date
  dueDate        DateTime         @db.Date
  notes          String?
  billingEmail   String? // a billing contact who gets the invoice too, besides the owner
  // What the invoice activates when paid (from the client's chosen plan); null on a plain invoice.
  planKey        String?
  interval       BillingInterval?
  // Snapshots taken when the invoice is sent, so the PDF and the email never change afterwards.
  billTo         Json?
  seller         Json?
  pdfPath        String? // object path in the private "invoices" Storage bucket
  sentAt         DateTime?
  sentTo         String[]         @default([])
  reminderSentAt DateTime? // the due-date reminder, claimed before sending
  paidAt         DateTime?
  paidBy         String? // "momo:<ManualPayment id>" | "manual:<ManualPayment id>" | "paddle:<subscription id>"
  // A payment that arrived for this invoice but could not be matched to its total (a card payment at the plan's USD
  // price for an RWF invoice, an invoice with extra lines): { source, reference, transactionId, amountMinor, currency,
  // receivedAt, planKey, interval }. The invoice stays "sent" until an admin checks and marks it paid.
  paymentReview  Json?
  voidedAt       DateTime?
  voidReason     String?
  createdBy      String // AuditLog actor
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  manualPayments ManualPayment[]
  // Also a partial unique index in SQL ("Invoice_one_draft_per_business"): one draft per company.

  @@index([businessId, createdAt])
  @@index([status, dueDate])
}

// ---- Custom plans: add-on prices, offers and requests (docs/OFFERS.md) -----------------------------------------------

// What one add-on costs per month in one region: a feature (key from lib/features.ts, e.g. "websiteChat"), a tier of
// one ("managed:full") or a block of a usage limit ("block:text" = +blockSize texts, "seat" = one extra user). The list
// of add-ons is code (lib/offers/shared.ts ADDONS); the amounts are data, edited in Admin -> Add-on prices (audited).
model AddonPrice {
  id           String   @id @default(cuid())
  addonKey     String
  regionKey    String
  currency     String
  monthlyMinor Int // smallest currency unit; RWF has none (whole francs)
  updatedBy    String? // AuditLog actor of the last change
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([addonKey, regionKey])
  @@index([regionKey])
}

// A custom plan offered to one company (docs/OFFERS.md): draft -> sent -> accepted -> paid, or expired (a sent offer
// past validUntil) or withdrawn. The priced lines and totals are frozen when the offer is saved, so the client pays
// exactly what they were shown. Accepting prepares the company's private plan (customPlanKey, a PlanDefinition with
// isCustom) and the payment (Mobile Money with offerId, or an invoice); confirming the payment switches it on.
model PlanOffer {
  id              String             @id @default(cuid())
  businessId      String
  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestId       String?
  request         CustomPlanRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  basePlanKey     String? // the regional plan it starts from, or null for features only
  featureKeys     Json // FeatureKey[], prerequisites included
  limits          Json // PlanLimits of the custom plan
  options         Json               @default("{}") // { managedTier?: "light" | "full" }
  currency        String
  interval        BillingInterval
  lines           Json // [{ key, label, quantity, unitMinor, totalMinor }] for the interval
  computedMinor   Int // the sum of the lines
  adjustedMinor   Int // what the client pays (the computed total, or the admin's rounding / discount)
  adjustReason    String?
  note            String? // the admin's message to the client
  status          String             @default("draft") // draft | sent | accepted | paid | expired | withdrawn
  validUntil      DateTime?
  sentAt          DateTime?
  acceptedAt      DateTime?
  payMethod       String? // "momo" | "invoice"
  customPlanKey   String? // PlanDefinition.key prepared on accept
  invoiceId       String? // the invoice made from the offer, when paid that way
  // Payment reminders of an accepted, unpaid offer (day 3 and day 7 after accepting), claimed before sending.
  reminder3SentAt DateTime?
  reminder7SentAt DateTime?
  paidAt          DateTime?
  paidBy          String? // "manual_payment:<id>"
  withdrawnAt     DateTime?
  withdrawReason  String?
  createdBy       String // AuditLog actor
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  manualPayments ManualPayment[]
  // Also a partial unique index in SQL ("PlanOffer_one_open_per_business"): at most one sent or accepted offer per company.

  @@index([businessId, createdAt])
  @@index([status, validUntil])
  @@index([invoiceId])
}

// "Request a custom plan" (pricing page, Billing, "Add to your plan", the demo booking): what the business needs, for
// the admin to answer with an offer. Linked to the company (and its demo booking, when it has one).
model CustomPlanRequest {
  id            String    @id @default(cuid())
  businessId    String?
  // Cascade: a deleted company takes its requests (names, emails and phones) with it.
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId        String?   @db.Uuid // who sent it
  demoBookingId String? // the company's live demo booking when it was sent
  name          String
  email         String
  phone         String?
  companyName   String
  description   String // what the business does
  goals         String? // no longer asked on the form (13 October 2026); older requests keep theirs
  featureKeys   Json // FeatureKey[] of interest
  budget        String? // a budget range key (lib/offers/shared.ts BUDGET_RANGES)
  source        String    @default("billing") // billing | pricing | upgrade | demo
  status        String    @default("new") // new | contacted | offered | closed
  handledBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  offers PlanOffer[]
  calls  DemoBooking[] // the short calls booked right after sending it (lib/demo/plan-calls.ts)

  @@index([status, createdAt])
  @@index([businessId, createdAt])
}

// ---- Video Studio (docs/VIDEO_APP_INTEGRATION.md) ----

// One video the studio makes: a Motion design (the browser draws the MP4), a Premium 3D clip (the render worker) or a
// Seedance clip (BytePlus), with its credits, scores and file. engine and status are text with CHECK constraints in the
// migration (20261022100000_video_studio), like ContentVisual.
model VideoJob {
  id             String            @id @default(cuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId         String?           @db.Uuid // who pressed Generate; null for Autopilot
  productId      String?
  product        Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  campaignId     String?
  campaign       Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contentId      String? // the GeneratedContent it belongs to, when made from a post
  content        GeneratedContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  parentId       String? // the job an edit, extend, re-render or overlay came from
  parent         VideoJob?         @relation("VideoJobParent", fields: [parentId], references: [id], onDelete: SetNull)
  children       VideoJob[]        @relation("VideoJobParent")
  engine         String // "motion" | "premium3d" | "seedance"
  mode           String? // "reference" | "text" | "image" | "first-last" | "edit" | "extend"
  status         String            @default("designing") // designing, designed, rendering, submitted, queued, running, ready, failed, cancelled, preview, preview-ready
  templateId     String?
  hookId         String?
  platform       String? // "tiktok" | "instagram" | "facebook" | "youtube"; null for any
  ratio          String            @default("9:16")
  seconds        Int
  quality        String? // MP4 size, Premium 540p/720p, or "<tier> <resolution>" for Seedance
  brief          Json // the DesignBrief or PromptBrief, photos as Storage paths (no image bytes)
  spec           Json? // MotionSpec, or the overlay spec of a Seedance clip
  scene          Json? // BlenderScene (Premium 3D)
  prompt         String? // the Seedance prompt as sent
  references     Json              @default("[]") // what was sent: [{ name, label, path, role }]
  providerTaskId String?           @unique // BytePlus task id
  storyboard     Json? // a free preview's storyboard (no key yet)
  caption        String            @default("")
  hashtags       String[]          @default([])
  videoPath      String? // the MP4 in the Gallery (a MediaAsset, gallery-videos bucket: <userId>/clips/<id>.mp4)
  posterPath     String?
  bytes          Int               @default(0) // counted toward the media quota
  durationMs     Int?
  voiceClipId    String?
  voiceClip      VoiceClip?        @relation(fields: [voiceClipId], references: [id], onDelete: SetNull)
  // The library track mixed into the MP4: { trackId, title, attribution, owned }. A track whose licence asks for a
  // credit puts its attribution on the posts (withMusicCredit). Null: no music.
  music          Json?
  credits        Int               @default(0) // video credits taken (0 for previews)
  periodStart    DateTime? // the UsageRecord window they were taken from, for the refund
  // A voice-over's credits while its take is being made (lib/video-studio/voice.ts): set when they are taken, cleared
  // when the take is paid for or the credits are given back. The video-jobs sweep refunds one left older than the lease.
  voiceCredits     Int             @default(0)
  voicePeriodStart DateTime?
  voiceReservedAt  DateTime?
  refundedAt     DateTime?
  costUsd        Decimal           @default(0) @db.Decimal(12, 6) // provider cost (its AiCall rows)
  warnings       Json              @default("[]") // fact warnings (lib/video-engine/factcheck.ts)
  score          Json? // research score (brain scoreDesign / scoreSeedancePrompt)
  captionScore   Json? // brain scoreCaption
  error          String?
  attempts       Int               @default(0)
  leaseUntil     DateTime? // the design sweep, render worker or poller holding it
  nextPollAt     DateTime? // Seedance: when the cron checks BytePlus next
  expiresAt      DateTime? // Seedance: execution_expires_after (BytePlus ends it unbilled)
  // "Your video is ready" (docs/VIDEO_STUDIO_SPLIT.md): when the video-jobs sweep sent the email, and when the client
  // first opened the video in BuPulse's Videos library (the bell shows ready videos not seen yet).
  readyNoticeAt  DateTime?
  seenAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  outcomes       VideoOutcome[]

  @@index([businessId, createdAt])
  @@index([status, nextPollAt])
  @@index([engine, status, leaseUntil])
  @@index([contentId])
  @@index([status, readyNoticeAt])
}

// One-click sign-in from BuPulse to the Video Studio (studio.bupulse.com, docs/VIDEO_STUDIO_SPLIT.md): BuPulse writes
// a ticket and sends the client to the studio with its token; the studio redeems it once, within 2 minutes. Only the
// token's SHA-256 is stored.
model StudioTicket {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String    @db.Uuid // who pressed "Open Video Studio"
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

// What a posted studio video did 24 hours and 7 days after it went out (lib/video-engine/brain/types.ts Outcome); the
// Brain learns from these (docs/research/BRAIN.md, "Learning from our own results").
model VideoOutcome {
  id               String   @id @default(cuid())
  videoJobId       String
  videoJob         VideoJob @relation(fields: [videoJobId], references: [id], onDelete: Cascade)
  postId           String?  @unique
  post             Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  businessId       String
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sector           String
  platform         String
  templateId       String?
  hookId           String?
  formatId         String?
  captionFormulaId String?
  seconds          Int
  language         String?
  postedAt         DateTime
  stats24h         Json? // OutcomeStats: views, reach, likes, comments, saves, shares
  stats7d          Json?
  source           String   @default("bupulse")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sector, platform])
  @@index([businessId, postedAt])
}

// ---------------------------------------------------------------------------------------------------------------------
// Conversations engine (docs/INBOX.md, docs/AUTOMATIONS.md): contacts, the shared inbox and automations, for every
// channel (website chat now; Instagram and Facebook through Composio or Meta; WhatsApp and others later).

// Where a message comes from or goes to.
enum ChannelKind {
  WEBSITE
  INSTAGRAM
  FACEBOOK
  WHATSAPP
  TELEGRAM
  TIKTOK
  EMAIL
  SMS
}

// One real person a business talks to, on any channel. Several ContactIdentity rows join their channels together.
model Contact {
  id             String            @id @default(cuid())
  businessId     String
  business       Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String?
  email          String?
  phone          String? // normalised (lib/leads/normalize.ts)
  avatarUrl      String?
  language       String? // last detected language, e.g. "rw", "en", "fr"
  // Custom field values, keyed by ContactField.key, e.g. {"budget": "200000", "district": "Gasabo"}.
  fields         Json              @default("{}")
  emailOptIn     Boolean           @default(false) // agreed to receive broadcasts by email
  unsubscribedAt DateTime? // asked to stop broadcasts (any channel)
  lastChannel    ChannelKind?
  lastSeenAt     DateTime          @default(now()) // last message from them
  mergedIntoId   String? // set when merged into another contact; the row is kept for old links, hidden from lists
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt
  identities     ContactIdentity[]
  tags           ContactTagLink[]
  conversations  Conversation[]
  leads          Lead[]
  runs           AutomationRun[]

  @@index([businessId, lastSeenAt])
  @@index([businessId, email])
  @@index([businessId, phone])
  @@index([businessId, createdAt])
}

// How a contact is known on one channel: the Instagram-scoped id, a Facebook PSID, the website visitor id, a phone.
model ContactIdentity {
  id           String      @id @default(cuid())
  businessId   String
  contactId    String
  contact      Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel      ChannelKind
  externalId   String
  connectionId String? // the connected account (Connection.id) the person wrote to, for social channels
  handle       String? // @username on Instagram, etc.
  displayName  String?
  createdAt    DateTime    @default(now())

  @@unique([businessId, channel, externalId])
  @@index([contactId])
}

model ContactTag {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  color      String?
  createdAt  DateTime         @default(now())
  links      ContactTagLink[]

  @@unique([businessId, name])
}

model ContactTagLink {
  contactId String
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tagId     String
  tag       ContactTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@id([contactId, tagId])
  @@index([tagId])
}

// A custom field the business defines for its contacts ("Budget", "District", "Size").
model ContactField {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key        String // lower_snake, unique per business, used in Contact.fields and in automation variables
  label      String
  type       String   @default("text") // "text" | "number" | "date" | "choice" | "yes_no"
  options    String[] // for "choice"
  createdAt  DateTime @default(now())

  @@unique([businessId, key])
}

enum ConversationStatus {
  OPEN
  CLOSED
}

// One thread with a contact on one channel (one website chat session, one Instagram DM thread, the comments of one
// person). The inbox lists these.
model Conversation {
  id               String             @id @default(cuid())
  businessId       String
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel          ChannelKind
  connectionId     String? // the connected social account, null for the website
  connection       Connection?        @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  externalThreadId String? // the platform's thread id; null for the website (chatSessionId is used)
  chatSessionId    String?            @unique // the website chat session this mirrors
  chatSession      ChatSession?       @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  status           ConversationStatus @default(OPEN)
  assigneeId       String?            @db.Uuid // the teammate (User.id) it is assigned to
  assignee         User?              @relation("ConversationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  botPausedUntil   DateTime? // a person took over: automations and AI stay quiet until then
  unread           Int                @default(0) // messages from the contact not yet opened by the team
  preview          String? // the last message, shortened, for the list
  lastMessageAt    DateTime           @default(now())
  lastInboundAt    DateTime? // the contact's last message: starts the 24-hour window on Meta channels
  createdAt        DateTime           @default(now())
  messages         Message[]
  runs             AutomationRun[]

  @@unique([businessId, channel, externalThreadId])
  @@index([businessId, status, lastMessageAt])
  @@index([businessId, assigneeId, status])
  @@index([contactId])
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Who wrote a message: the contact, an automation or the AI, a teammate, or BuPulse itself (a note in the thread).
enum MessageAuthor {
  CONTACT
  BOT
  AGENT
  SYSTEM
}

// "MESSAGE" is a chat or DM; "COMMENT" a comment under a post; "COMMENT_REPLY" the public answer to one; "NOTE" a team
// note only the business sees.
enum MessageKind {
  MESSAGE
  COMMENT
  COMMENT_REPLY
  STORY_MENTION
  NOTE
}

enum MessageStatus {
  RECEIVED
  QUEUED
  SENT
  FAILED
}

model Message {
  id              String           @id @default(cuid())
  businessId      String
  conversationId  String
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction       MessageDirection
  author          MessageAuthor
  kind            MessageKind      @default(MESSAGE)
  agentId         String?          @db.Uuid // the teammate who wrote it (author AGENT)
  text            String
  // Buttons, quick replies, images, link cards: {buttons: [{id, title, url?}], image?: url, quickReplies?: [...]}
  payload         Json?
  externalId      String? // the platform's message or comment id (dedupe)
  postExternalId  String? // the post a comment is under
  status          MessageStatus    @default(RECEIVED)
  error           String?
  automationRunId String?
  createdAt       DateTime         @default(now())

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([businessId, createdAt])
}

enum AutomationStatus {
  DRAFT
  LIVE
  PAUSED
}

// An automation drawn on the canvas: a trigger node and steps joined by lines (docs/AUTOMATIONS.md). `graph` is the
// draft being edited; `liveGraph` is the published copy that runs, so editing never changes a running automation.
model Automation {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  status      AutomationStatus @default(DRAFT)
  triggerType String? // copied from the live graph's trigger node, for fast lookup: "keyword", "comment_keyword", ...
  channels    ChannelKind[] // channels the live trigger listens on
  graph       Json // {nodes: [...], edges: [...]}
  liveGraph   Json?
  version     Int              @default(0) // bumped on every publish
  templateKey String? // the template it was made from
  createdById String?          @db.Uuid
  publishedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  runs        AutomationRun[]

  @@index([businessId, status, triggerType])
}

enum AutomationRunStatus {
  RUNNING
  WAITING // waiting for a reply, a delay or a button
  DONE
  STOPPED // replaced by a newer run, a person took over, or the automation was paused
  FAILED
}

// One contact going through one automation.
model AutomationRun {
  id             String              @id @default(cuid())
  businessId     String
  automationId   String
  automation     Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  version        Int // the automation version it runs
  contactId      String
  contact        Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   Conversation?       @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  status         AutomationRunStatus @default(RUNNING)
  nodeId         String? // the step it is on (waiting at)
  waitingFor     String? // "reply" | "button" | "delay"
  // Answers and variables collected so far, and the trigger's data (comment id, post id, matched keyword).
  context        Json                @default("{}")
  error          String?
  startedAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt
  finishedAt     DateTime?

  @@index([automationId, status])
  @@index([contactId, status])
  @@index([businessId, startedAt])
}

enum DueJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Work to do at a time: resume an automation after a delay, send a follow-up, check a social account for new comments.
// The every-minute cron (/api/cron/due-jobs) claims due rows.
model DueJob {
  id         String       @id @default(cuid())
  businessId String?
  kind       String // "automation.resume" | "automation.timeout" | "social.poll" | ...
  runAt      DateTime
  payload    Json         @default("{}")
  status     DueJobStatus @default(PENDING)
  attempts   Int          @default(0)
  dedupeKey  String?      @unique // one pending job per key (e.g. "poll:<connectionId>")
  lastError  String?
  claimedAt  DateTime?
  createdAt  DateTime     @default(now())
  doneAt     DateTime?

  @@index([status, runAt])
  @@index([businessId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Partner programme (docs/bizdev/PLAN.md section 6, docs/guide/features/25-partners.md): agencies, co-working
// spaces, MoMo agents and happy clients who refer companies for a commission on confirmed payments.

// A partner, from the application on /partners to approval in Admin -> Sales -> Partners. Only an approved partner has
// a code; its ?ref= link reuses the staff referral cookie (lib/sales/ref-cookie.ts).
model Partner {
  id           String            @id @default(cuid())
  status       String            @default("applied") // applied | approved | rejected | paused
  kind         String // agency | coworking | momo_agent | client | consultant | other
  name         String
  organisation String?
  email        String // lower case
  phone        String // E.164 when it parses, else as typed
  city         String?
  message      String? // how they will find clients, in their words
  // 7 unambiguous characters (staff codes are 5 or 6, so the two never clash); set on approval.
  refCode      String?           @unique
  // The partner's private page /partners/me/<token> (32 random bytes, base64url); set on approval.
  viewToken    String?           @unique
  rejectReason String?
  decidedBy    String? // AuditLog actor
  decidedAt    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  referrals    PartnerReferral[]
  payouts      PartnerPayout[]

  @@index([status])
  @@index([email])
}

// A company that signed up with a partner's link. No foreign key to Business or User (like BillingEvent): the
// commission history stays when an account is deleted. One partner per company.
model PartnerReferral {
  id         String   @id @default(cuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  businessId String   @unique
  userId     String   @db.Uuid // the company owner: payments (BillingEvent) carry it
  code       String
  createdAt  DateTime @default(now())

  @@index([partnerId])
  @@index([userId])
}

// Commission paid to a partner by hand (Mobile Money), recorded from Admin. The payout's MoMo transaction id is unique,
// so one payment is never recorded twice.
model PartnerPayout {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  amountMinor Int
  currency    String   @default("RWF")
  reference   String   @unique // upper case
  note        String?
  paidAt      DateTime
  createdBy   String // AuditLog actor
  createdAt   DateTime @default(now())

  @@index([partnerId, paidAt])
}

// The free first-post preview (docs/guide/features/29-first-post-preview.md): one AI post a company may make while it
// waits for its demo, when Admin -> Settings switches it on. One row per company (unique businessId) is what keeps it to
// one. No foreign key (like PartnerReferral); the account purge deletes it by userId.
model FirstPostPreview {
  id         String   @id @default(cuid())
  businessId String   @unique
  userId     String   @db.Uuid // the company owner
  status     String   @default("making") // making | ready | failed
  attempts   Int      @default(1) // a failed preview may be tried once more (FIRST_POST_MAX_ATTEMPTS)
  caption    String?
  hashtags   String[]
  headline   String?
  provider   String?
  model      String?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// Link in bio (docs/guide/features/33-link-in-bio.md): the company's public page at /b/<slug>, for the Instagram or
// TikTok bio. Built from the Knowledge base (business info, products, logo); off until the owner switches it on, and
// it shows only the contacts, place and products the owner put on it (lib/bio).
model BioPage {
  businessId String        @id
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled    Boolean       @default(false)
  slug       String        @unique // lowercase letters, digits and dashes (lib/bio/slug.ts)
  tagline    String? // the line under the name; null = the Company profile's tagline, else the description
  whatsapp   String? // E.164 of the WhatsApp button, one of the business's contacts; null = no button
  message    String? // the WhatsApp message the visitor starts with; null = the default
  phone      String? // E.164 of the Call button; null = no button
  location   String? // the address of the place shown (Business info -> Locations); null = none
  landmark   String? // "Opposite the bus park, next to the MTN shop"
  showHours  Boolean       @default(true)
  links      String[] // contact types shown as links: website, instagram, tiktok, facebook
  logoPath   String? // small JPEG copy of the logo in "media" (<userId>/bio/...), made on save
  logoSource String? // the brand logo path the copy was made from
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  items      BioPageItem[]
  days       BioPageDay[]
}

// A product or service on the page, in the owner's order, with a small copy of its first photo.
model BioPageItem {
  id          String  @id @default(cuid())
  businessId  String
  page        BioPage @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  photoPath   String? // small JPEG in "media" (<userId>/bio/...), made on save; null = no photo
  photoSource String? // the gallery photo (MediaAsset.path) the copy was made from

  @@unique([businessId, productId])
  @@index([productId])
}

// Visits and taps on the page, one row per company and day (UTC): "how many messages did my bio bring".
model BioPageDay {
  businessId String
  page       BioPage  @relation(fields: [businessId], references: [businessId], onDelete: Cascade)
  date       DateTime @db.Date
  views      Int      @default(0)
  whatsapp   Int      @default(0)
  calls      Int      @default(0)

  @@id([businessId, date])
}

// A real client's words on the marketing home page (docs/guide/features/34-testimonials.md), added in Admin ->
// Testimonials. Shown only when published, and it can only be published with the client's consent.
model SiteTestimonial {
  id         String   @id @default(cuid())
  clientName String
  business   String
  sector     String?
  quote      String
  result     String? // "12 orders on WhatsApp in a week"
  photo      Bytes? // small square JPEG (lib/testimonials), shown as it is
  consent    Boolean  @default(false) // the client agreed to be shown
  published  Boolean  @default(false)
  position   Int      @default(0)
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, position])
}

// Creator campaigns (docs/CREATOR_CAMPAIGNS.md): a company runs a campaign for content creators, who post the daily
// tasks on their own Instagram (professional), Facebook Page or TikTok and are paid by the company for the views their
// posts make. BuPulse reads each post's views through BuPulse-Socials (Composio) and works out what each creator earned
// per 30-day period (lib/creators/pay.ts); the company pays by Mobile Money itself and marks it paid. Amounts are whole
// units of the campaign's currency (RWF has no cents).
model CreatorCampaign {
  id                    String              @id @default(cuid())
  businessId            String
  business              Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slug                  String              @unique // the public application page /c/<slug> (lib/creators/slug.ts)
  name                  String
  brief                 String // the challenge and what the videos should show, for the whole campaign
  rules                 String? // the company's own written rules, shown to creators before they apply and on every task
  status                String              @default("DRAFT") // DRAFT | LIVE | PAUSED | ENDED
  listed                Boolean             @default(true) // shown on the marketplace /creators: the company's switch (docs/CREATOR_MARKETPLACE.md)
  hiddenAt              DateTime? // hidden from the marketplace by a BuPulse admin, whatever `listed` says
  hiddenReason          String?
  acceptingApplications Boolean             @default(true)
  startsOn              DateTime            @db.Date // first day, in the company's timezone
  endsOn                DateTime            @db.Date // last day (inclusive)
  platforms             String[] // "instagram" | "facebook" | "tiktok"
  mentions              String[] // the caption must contain at least one of these: @handle, #hashtag or a link (empty: no check)
  currency              String              @default("RWF")
  payRules              Json // PayRules (lib/creators/pay.ts): rate per 1,000 views, milestones, fee per post, caps
  viewTargetPerCreator  Int? // default for new periods: views per creator per period that earn; more do not count
  viewTargetCampaign    Int? // default for new periods: views of all creators together per period that earn
  questions             Json? // the company's own application questions: [{ id, label, required }] (campaigns made before the wizard)
  // The step-by-step creation wizard (docs/CREATOR_CAMPAIGN_WIZARD.md, lib/creators/wizard.ts).
  setupStep             Int? // null: all steps done; 1-12: a draft left at that step ("Continue")
  idea                  String? // the owner's one line the AI fills the other steps from
  kind                  String? // PRODUCT_REVIEW | CHALLENGE | UNBOXING | TUTORIAL | EVENT | LAUNCH | TESTIMONIAL | OTHER
  goal                  String? // VIEWS | SALES | VISITS | FOLLOWERS | DOWNLOADS
  knowledgeCampaignId   String? // the Business info campaign it promotes, if any
  knowledgeCampaign     Campaign?           @relation(fields: [knowledgeCampaignId], references: [id], onDelete: SetNull)
  productIds            String[] // Business info products it promotes
  requirements          Json? // CreatorRequirements (lib/creators/requirements.ts): niches, locations, languages, min followers, how many
  formats               String[] // REEL | STORY | POST | CAROUSEL | SHORT_VIDEO | LIVE
  platformMode          String              @default("ANY") // ALL: post on every platform | ANY: on any one of them (new tasks' default)
  briefEvery            String? // MONTH | WEEK | DAY: how often a new brief (task) comes
  dos                   String[]
  donts                 String[]
  applicationForm       Json? // ApplicationForm (lib/creators/form-fields.ts); null: the default form plus `questions`
  files                 Json? // CampaignFiles (lib/creators/wizard.ts): the Photos folders, a Drive link, example links
  look                  Json? // CampaignLook (lib/creators/wizard.ts): the application page's cover
  createdBy             String?             @db.Uuid
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  tasks                 CreatorTask[]
  creators              CampaignCreator[]
  periods               CreatorPeriod[]
  submissions           CreatorSubmission[]
  posts                 CreatorPost[]
  reports               CreatorReport[]

  @@index([businessId, status])
}

// What creators must post. A task covers a span of days (one day, a week, the whole month...) and repeats every day
// of it: each day the creator hands in `postsPerDay` posts for it.
model CreatorTask {
  id           String              @id @default(cuid())
  campaignId   String
  campaign     CreatorCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title        String
  instructions String
  startsOn     DateTime            @db.Date
  endsOn       DateTime            @db.Date
  postsPerDay  Int                 @default(1)
  platforms    String[] // a subset of the campaign's platforms
  platformMode String              @default("ANY") // ALL: a post on every platform | ANY: one post on any of them
  mediaKind    String              @default("ANY") // VIDEO | IMAGE | ANY
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  submissions  CreatorSubmission[]

  @@index([campaignId, startsOn, endsOn])
}

// The person who posts. One login across companies (owner decision, 21 October 2026): a creator's User row has no
// Business and no Membership; their campaigns come from CampaignCreator rows.
model CreatorProfile {
  id          String              @id @default(cuid())
  userId      String              @unique @db.Uuid
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  campaigns   CampaignCreator[]
  connections CreatorConnection[]
  bio          String? // a few lines about them, on their marketplace profile
  location     String? // district or city, e.g. "Kigali, Gasabo"
  handles      Json? // [{ network, handle, followers }], the same shape as an application's
  samples      String[] // 1-3 links to their best posts
  discoverable Boolean   @default(false) // "Let companies find me": listed in the companies' creator search
  blockedAt    DateTime? // blocked from the marketplace by a BuPulse admin: no applying, not findable
  blockedReason String?
  reports      CreatorReport[]

  @@index([discoverable])
}

// One creator in one campaign, from the application to the end: APPLIED -> SELECTED (invite link sent) -> JOINED, or
// DECLINED; REMOVED by the company later. Before they join, the row holds the application only (profileId null).
model CampaignCreator {
  id              String              @id @default(cuid())
  campaignId      String
  campaign        CreatorCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  profileId       String?
  profile         CreatorProfile?     @relation(fields: [profileId], references: [id], onDelete: SetNull)
  status          String              @default("APPLIED") // APPLIED | SELECTED | JOINED | DECLINED | REMOVED | OFFERED (the company invited a marketplace creator, waiting for their answer)
  source          String              @default("LINK") // LINK: applied on /c/<slug> | MARKETPLACE: applied from their creator account | OFFER: the company invited them
  offeredBy       String?             @db.Uuid
  offeredAt       DateTime?
  name            String
  email           String // lowercase
  phone           String? // WhatsApp, E.164 when it could be read
  handles         Json // [{ network, handle, followers }]
  samples         String[] // 1-3 links to their best posts
  answers         Json? // { [questionId]: answer }
  inviteTokenHash String?             @unique // sha-256 of the invite link's token (single use)
  inviteExpiresAt DateTime?
  selectedAt      DateTime?
  joinedAt        DateTime?
  removedAt       DateTime?
  note            String? // the company's private note
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  submissions     CreatorSubmission[]
  posts           CreatorPost[]
  payouts         CreatorPayout[]

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([profileId])
}

// A creator's own Instagram, Facebook Page or TikTok, connected through BuPulse-Socials (Composio, user id
// "creator_<profileId>"). Views are read with it, and a handed-in link must be a post of one of these accounts.
model CreatorConnection {
  id                         String         @id @default(cuid())
  profileId                  String
  profile                    CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  network                    String // instagram | facebook | tiktok
  composioConnectedAccountId String
  externalAccountId          String // Instagram user id, Facebook Page id, TikTok open_id
  username                   String?
  displayName                String?
  accountType                String? // "business" | "creator" | "page" | ...
  avatarUrl                  String?
  followers                  Int? // read from the network when connected and at each check: verifies what they typed when applying
  followersAt                DateTime?
  status                     String         @default("ACTIVE") // ACTIVE | EXPIRED | REVOKED
  lastError                  String?
  lastCheckedAt              DateTime?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  posts                      CreatorPost[]

  @@unique([profileId, network, externalAccountId])
  @@index([status])
}

// A task handed in for one day: what the creator wrote and the files they used. Auto-approved (owner decision); the
// company can reject it later, which takes away its pay.
model CreatorSubmission {
  id                String          @id @default(cuid())
  campaignId        String
  campaign          CreatorCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  taskId            String
  task              CreatorTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  campaignCreatorId String
  campaignCreator   CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  day               DateTime        @db.Date // the task day it is for
  title             String
  caption           String
  mediaPaths        String[] // Storage paths of the uploaded images and videos (bucket "creator-media")
  status            String          @default("ACCEPTED") // ACCEPTED | REJECTED
  rejectedAt        DateTime?
  rejectReason      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  posts             CreatorPost[]

  @@index([campaignId, day])
  @@index([campaignCreatorId, day])
}

// One post link of a submission, on one platform. Its views are read every 6 hours (lib/creators/tracking) and kept
// as snapshots, so a period counts the views that happened inside it.
model CreatorPost {
  id                String                @id @default(cuid())
  submissionId      String
  submission        CreatorSubmission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  campaignId        String
  campaign          CreatorCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignCreatorId String
  campaignCreator   CampaignCreator       @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  connectionId      String?
  connection        CreatorConnection?    @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  network           String
  url               String
  externalId        String? // the network's id of the post, found from the link on the creator's account
  postedAt          DateTime? // from the network
  networkCaption    String? // the caption as the network has it (the mention check reads this)
  checks            Json? // { ownAccount, onTime, mention }: true | false | null (not checked yet)
  status            String                @default("CHECKING") // CHECKING | TRACKING | INVALID | REMOVED | REJECTED | FINAL
  statusReason      String?
  removedAt         DateTime?
  views             Int                   @default(0) // latest reading
  impressions       Int                   @default(0)
  likes             Int                   @default(0)
  comments          Int                   @default(0)
  shares            Int                   @default(0)
  lastReadAt        DateTime?
  nextReadAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  snapshots         CreatorPostSnapshot[]

  // A post earns in one campaign only.
  @@unique([network, externalId])
  @@index([campaignId, status])
  @@index([campaignCreatorId])
  @@index([status, nextReadAt])
}

model CreatorPostSnapshot {
  id          String      @id @default(cuid())
  postId      String
  post        CreatorPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  capturedAt  DateTime    @default(now())
  views       Int
  impressions Int         @default(0)
  likes       Int         @default(0)
  comments    Int         @default(0)
  shares      Int         @default(0)

  @@index([postId, capturedAt])
}

// A 30-day pay period of a campaign (the last one can be shorter), with its own goals. CLOSED when its final counts
// were taken and the payouts written; nothing in it changes after that.
model CreatorPeriod {
  id                   String          @id @default(cuid())
  campaignId           String
  campaign             CreatorCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  index                Int // 1, 2, 3...
  startsAt             DateTime // start of its first day in the company's timezone
  endsAt               DateTime // start of the day after its last day
  viewTargetPerCreator Int?
  viewTargetCampaign   Int?
  budget               Int? // most the company pays for this period, all creators together
  status               String          @default("OPEN") // OPEN | CLOSED
  closedAt             DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  payouts              CreatorPayout[]

  @@unique([campaignId, index])
  @@index([status, endsAt])
}

// What one creator earned in one period: written when the period closes, then marked paid by the company.
model CreatorPayout {
  id                String          @id @default(cuid())
  periodId          String
  period            CreatorPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  campaignCreatorId String
  campaignCreator   CampaignCreator @relation(fields: [campaignCreatorId], references: [id], onDelete: Cascade)
  countedViews      Int
  amount            Int // what is owed: earnings minus deductions
  deductions        Int             @default(0) // pay taken back for posts removed or rejected after an earlier period was paid
  breakdown         Json // PayoutBreakdown (lib/creators/pay.ts): per post views, rate pay, milestones, fees, caps
  status            String          @default("DUE") // DUE | PAID
  paidAt            DateTime?
  paidBy            String?         @db.Uuid
  reference         String? // the Mobile Money reference the company typed
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([periodId, campaignCreatorId])
  @@index([campaignCreatorId, status])
}

// A report from the marketplace (docs/CREATOR_MARKETPLACE.md): a creator reports a campaign (e.g. a company that does
// not pay), or a company reports a creator (e.g. fake views). It lands in the admin console's inbox.
model CreatorReport {
  id             String           @id @default(cuid())
  kind           String // CAMPAIGN | CREATOR: what is reported
  campaignId     String?
  campaign       CreatorCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  profileId      String?
  profile        CreatorProfile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  reporterUserId String           @db.Uuid // the person who reported (a creator's or a company member's login)
  businessId     String? // the reporting company, when a company reported
  reason         String // SCAM | NOT_PAID | FAKE_VIEWS | SPAM | OFFENSIVE | OTHER
  details        String?
  status         String           @default("OPEN") // OPEN | RESOLVED
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?
  createdAt      DateTime         @default(now())

  @@index([status, createdAt])
}
