# The production Video Studio's environment (studio.bupulse.com). Copy this file to ~/.bupulse/studio.env (OUTSIDE the
# repo), fill in every value, and lock it:  chmod 600 ~/.bupulse/studio.env
# NEVER commit the filled-in file. Values are never printed by the studio. See "Going live" in docs/STUDIO_DEPLOY.md.

# --- Mode and addresses ---
STUDIO_ENV=production
STUDIO_URL=https://studio.bupulse.com
BUPULSE_URL=https://bupulse.com
VIDEO_LAB_PORT=3110

# --- Sign-in: the cookie secret (32 or more random characters:  openssl rand -hex 32) and the owner's door password ---
STUDIO_SESSION_SECRET=
STUDIO_PASSWORD=

# --- The SAME database and Storage as bupulse.com (the PRODUCTION Supabase project, not the TEST one) ---
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The same as the app's, so the keys saved in Admin -> Services can be read.
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=

# --- AI (API keys only: the Claude subscription is never used in production) ---
ANTHROPIC_API_KEY=
# Optional: left empty, that feature is off (voice-overs, AI images and presenter shots, real Seedance video).
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
SEEDANCE_API_KEY=

# Never set these in production: STUDIO_DEV_TICKETS, VIDEO_LAB_CLAUDE, VIRAL_ROWS_DIR, VIRAL_FRAMES_DIR
