# Copy to .env and fill in. Never commit .env. Only NEXT_PUBLIC_* values reach the browser.

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Supabase database (Connect button → ORMs → Prisma) ---
# Pooled "transaction" connection, used by the app at runtime:
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct "session" connection, used by Prisma migrations:
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- AI providers ---
# "gemini" (free tier, for development) or "claude"
AI_TEXT_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-3.8-flash"
# Used automatically when the main text model is busy.
GEMINI_TEXT_FALLBACK_MODEL="gemini-3.1-flash-lite"
ANTHROPIC_API_KEY=""
CLAUDE_TEXT_MODEL="claude-opus-5-5"
CLAUDE_EFFORT="medium"
# Short structured calls (the Knowledge base marketing interview). Empty: gemini-3.1-flash-lite, or claude-sonnet-5-5 with Claude.
CHEAP_TEXT_MODEL=""

# --- Encryption (third-party tokens, users' own Composio keys) ---
# Base64, 32 bytes. Generate with: openssl rand -base64 32
# To rotate: set ENCRYPTION_KEY_ID="2", put the new key in ENCRYPTION_KEY and the old one in ENCRYPTION_KEY_1
ENCRYPTION_KEY=""
# Server secret mixed into API key hashes (lib/api/keys.ts, HMAC-SHA256). Optional: without it a key derived from
# ENCRYPTION_KEY is used. Set it once before go-live (openssl rand -base64 32); changing it invalidates every API key.
API_KEY_PEPPER=""

# --- Account deletion (daily purge job) ---
# Supabase → Project Settings → API Keys → secret key (sb_secret_…). Lets the purge job remove Storage files.
SUPABASE_SECRET_KEY=""
# Any long random string (openssl rand -hex 32). Same value in Cloudflare secrets and GitHub Actions secrets.
CRON_SECRET=""

# --- Later phases (not used yet) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
ELEVENLABS_API_KEY=""

# --- Billing (Paddle; see docs/BILLING.md) ---
BILLING_PROVIDER=""
PADDLE_ENVIRONMENT=""
PADDLE_API_KEY=""
PADDLE_CLIENT_TOKEN=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_PRICE_STANDARD_MONTH=""
PADDLE_PRICE_STANDARD_YEAR=""
PADDLE_PRICE_PRO_MONTH=""
PADDLE_PRICE_PRO_YEAR=""

# Monthly cap on BuPulse AI spend in USD (AI calls pause when the cost ledger reaches it).
AI_MONTHLY_BUDGET_USD="20"
# Monthly AI allowance per company in USD (every AI feature; the owner sees "monthly AI allowance reached").
AI_COMPANY_MONTHLY_USD="3"
# The share (0 to 1) of AI_COMPANY_MONTHLY_USD the website chat may use each month; the rest stays the owner's
# (Studio, Autopilot, designs). When it is used, the chat only collects visitors' details. Default 0.5.
WIDGET_AI_SHARE="0.5"

# --- Canva ("Edit in Canva", see docs/CANVA.md). Leave CANVA_CLIENT_ID empty to hide the feature. ---
# Canva Developer Portal -> your integration -> Credentials
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""
# Must exactly match a Redirect URL in the portal. Default: NEXT_PUBLIC_SITE_URL + /api/canva/callback.
# Locally Canva needs 127.0.0.1, not localhost, e.g. http://127.0.0.1:3000/api/canva/callback
CANVA_REDIRECT_URI=""

# --- Google Calendar for demo bookings (Admin -> Settings -> Google Calendar, see docs/GOOGLE_CALENDAR.md). ---
# OAuth web client in Google Cloud project bupulse-511410; redirect URI: ${NEXT_PUBLIC_SITE_URL}/api/admin/google-calendar/callback.
# Leave empty to keep the meeting-link + .ics flow only.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# --- Website chat widget (docs/WIDGET.md) ---
# Model for chat replies; the main text model is the fallback.
WIDGET_MODEL="gemini-3.1-flash-lite"
# Cloudflare Turnstile (optional; without both keys the widget and the sign-up form rely on rate limits only).
# One widget in the Cloudflare dashboard for bupulse.com (and localhost for dev); the same keys serve both.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Import photos from Google Drive and Dropbox (docs/CONNECTORS.md). Leave empty to show "Coming soon". ---
# Google Cloud Console -> APIs & Services. Enable "Google Picker API" and "Google Drive API".
# Browser API key restricted to the Picker API and your site's domains.
GOOGLE_PICKER_API_KEY=""
# OAuth client ID (Web application) with your site as an authorized JavaScript origin.
# Falls back to GOOGLE_YOUTUBE_CLIENT_ID when empty.
GOOGLE_CLIENT_ID=""
# The Google Cloud project NUMBER (not the project ID).
GOOGLE_PICKER_APP_ID=""
# Dropbox App Console -> your app -> App key (Chooser drop-in; add your site under "Chooser/Saver domains").
DROPBOX_APP_KEY=""

# --- Shopify product import (docs/CONNECTORS.md). Leave empty to show "Coming soon". ---
# Shopify Partner Dashboard -> your app -> Client credentials (Client ID, Client secret).
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Admin API version (default 2026-07). Change only after checking Shopify's release notes.
SHOPIFY_API_VERSION=""

# --- Admin console (/admin). Comma-separated; the only accounts that can open it. Each also needs an authenticator-app code (Supabase MFA must be on). ---
ADMIN_EMAILS="admin@bupulse.com"
# Admin, Settings, Updates (docs/UPDATES.md): the GitHub repository (owner/name) and a fine-grained token with Actions: write and Contents: read. Leave empty to show "Not connected".
GITHUB_REPO=""
GITHUB_TOKEN=""
# Which deploy workflow the Updates page starts: cloudflare (deploy.yml) or netlify (deploy-netlify.yml). Empty = the host BuPulse runs on.
DEPLOY_TARGET=""

# --- Hosting (docs/DEPLOY_NETLIFY.md) ---
# netlify, cloudflare or node. Empty = detected (Netlify Functions, Cloudflare Workers, else plain Node).
PLATFORM=""
# "1" turns on GET /api/platform/check (what the app reads from the host's headers), for the post-deploy check only.
PLATFORM_CHECK=""
# Connections per pooled database client (1 to 20). Empty = 3 on Netlify, 10 elsewhere.
DATABASE_POOL_MAX=""

# --- First-party analytics (docs/handovers/phase-8-analytics.md) ---
# Local dev only: the country recorded when Cloudflare's header is missing (default ZZ).
ANALYTICS_DEV_COUNTRY=""
# Local dev only: "1" lets ?region=RW (kept in the bp-region cookie) override the visitor's region on the public pages. Leave empty in production (docs/REGIONS.md).
REGION_OVERRIDE=""
# "Use my location" country lookup: builtin (default: offline map, free, no outside service) or google (Geocoding API; needs GOOGLE_MAPS_API_KEY with billing).
GEO_PROVIDER=""

# --- Address search on the Brand page and onboarding (docs/BUSINESS_INFO.md) ---
# Server-only Google key with "Places API (New)" and (for "Use my location" on /pricing, docs/REGIONS.md) "Geocoding API" enabled. Never NEXT_PUBLIC_. Empty = plain address inputs.
GOOGLE_MAPS_API_KEY=""

# Public WhatsApp number for the "Chat on WhatsApp" button on the public pages (international format).
# Leave empty to hide the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=""
