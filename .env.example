# BuPulse environment variables. Copy to .env and fill in; never commit .env. Only NEXT_PUBLIC_* values reach the
# browser. Production: runtime values go in Netlify (Project configuration, Environment variables), build values in the
# GitHub `production` environment (docs/DEPLOY_NETLIFY.md). `node --env-file=.env scripts/check-env.mjs --runtime`
# checks a filled-in file; the deploy workflow runs the same checks (names and problems only, never values).
# Empty = not set; the comment says what happens then. [required] = production must have it.

# --- Site ---
# [required] The site's address: http://localhost:3000 in development, https://bupulse.com in production. Also a build value.
NEXT_PUBLIC_SITE_URL=""
# Public WhatsApp number for the "Chat on WhatsApp" button (international format, e.g. +250 791 954 277). Empty hides it.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Supabase (Project Settings, API) ---
# [required] Also build values (GitHub variables).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# [required] Secret key (sb_secret_...): server-only Storage work (Gallery videos, voiceovers, music, purges).
SUPABASE_SECRET_KEY=""

# --- Database (Supabase, Connect, ORMs, Prisma) ---
# [required] Pooled "transaction" connection (port 6543, ?pgbouncer=true), used by the app at runtime.
DATABASE_URL=""
# Direct "session" connection (port 5432), for migrations only (a GitHub secret in production, not in Netlify).
DIRECT_URL=""
# Connections per pooled client (1 to 20). Empty = 3 on Netlify, 10 elsewhere.
DATABASE_POOL_MAX=""
# The database size the admin Health page measures against, in MB. Empty = 500 (Supabase free plan).
DB_SIZE_LIMIT_MB=""

# --- Secrets ---
# [required] Base64, 32 bytes (openssl rand -base64 32): encrypts third-party tokens. Never change it after go-live.
# To rotate: set ENCRYPTION_KEY_ID="2", put the new key in ENCRYPTION_KEY and the old one in ENCRYPTION_KEY_1.
ENCRYPTION_KEY=""
ENCRYPTION_KEY_ID=""
# [required] Mixed into API key hashes (openssl rand -base64 32). Changing it invalidates every API key.
API_KEY_PEPPER=""
# [required] Bearer token of the scheduled jobs (openssl rand -hex 32); the same value as the GitHub secret.
CRON_SECRET=""
# Signs billing links. Empty = derived from ENCRYPTION_KEY.
BILLING_SIGNING_SECRET=""

# --- Admin console (/admin) ---
# [required] Comma-separated addresses allowed in (each also needs an authenticator-app code).
ADMIN_EMAILS=""
# Admin, Settings, Updates (docs/UPDATES.md): the repository (owner/name) and a fine-grained token (Actions: write,
# Contents: read). Empty shows "Not connected".
GITHUB_REPO=""
GITHUB_TOKEN=""
# Which deploy workflow Updates starts: netlify or cloudflare. Empty = the host BuPulse runs on.
DEPLOY_TARGET=""
# Extra origins allowed to call the admin MCP endpoint (comma-separated). Empty = this site only.
MCP_ALLOWED_ORIGINS=""

# --- AI ---
# [required] "gemini" or "claude": who writes the text.
AI_TEXT_PROVIDER=""
# Gemini: the text when AI_TEXT_PROVIDER=gemini, and always the AI designs and photos.
GEMINI_API_KEY=""
# Empty = the built-in default models.
GEMINI_TEXT_MODEL=""
GEMINI_TEXT_FALLBACK_MODEL=""
GEMINI_IMAGE_MODEL=""
# Claude: the text when AI_TEXT_PROVIDER=claude.
ANTHROPIC_API_KEY=""
CLAUDE_TEXT_MODEL=""
CLAUDE_EFFORT=""
# Short structured calls (interview, voiceover shortening). Empty = the provider's cheap model.
CHEAP_TEXT_MODEL=""
# Monthly cap on BuPulse's whole AI spend in USD (AI pauses at it; Admin, AI usage can override it). Empty = the default.
AI_MONTHLY_BUDGET_USD=""
# Monthly AI allowance per company in USD (every AI feature). Empty = 3.
AI_COMPANY_MONTHLY_USD=""
# Share (0 to 1) of a company's allowance the website chat may use. Empty = 0.5.
WIDGET_AI_SHARE=""
# Model for website chat replies. Empty = gemini-3.1-flash-lite.
WIDGET_MODEL=""

# --- Voiceover and music (docs/VOICE_AND_MUSIC.md) ---
# ElevenLabs (paid plan): voiceovers and "Generate a track". Server-only; empty turns both off.
ELEVENLABS_API_KEY=""
# Empty = eleven_multilingual_v2.
ELEVENLABS_MODEL=""

# --- Storage (docs/MEDIA.md) ---
# Shared storage guard in bytes (Supabase free plan: 1 GB in all). Empty = 900 MB.
MEDIA_PLATFORM_MAX_BYTES=""
# Gallery videos per company in bytes. Empty = 100 MB (104857600).
MEDIA_COMPANY_VIDEO_MAX_BYTES=""

# --- Video robot (docs/VIDEO_ROBOT.md) ---
# Long random string (openssl rand -hex 32), the same as the GitHub secret. Empty = owners make videos in their browser.
VIDEO_ROBOT_SECRET=""

# --- Email (Resend, docs/EMAIL_SETUP.md) ---
# [required] Sign-in links, reminders, invoices and digests.
RESEND_API_KEY=""
# Sender, e.g. "BuPulse <hello@bupulse.com>". Empty = the built-in default.
RESEND_FROM=""

# --- Social networks (docs/PLATFORM_APPS.md). Empty hides that network's Connect button. ---
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Instagram Login (optional; Instagram through Facebook works without it).
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Another Meta app secret the data-deletion callback accepts (optional).
META_APP_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# "true" once LinkedIn approved Community Management (company pages).
LINKEDIN_COMMUNITY_MANAGEMENT=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# "true" once TikTok verified the media domain (photo posts).
TIKTOK_PHOTO_POSTING=""
GOOGLE_YOUTUBE_CLIENT_ID=""
GOOGLE_YOUTUBE_CLIENT_SECRET=""

# --- Billing (Paddle, docs/BILLING.md). Empty = Mobile Money and invoices only. ---
BILLING_PROVIDER=""
# sandbox or production.
PADDLE_ENVIRONMENT=""
PADDLE_API_KEY=""
PADDLE_CLIENT_TOKEN=""
PADDLE_WEBHOOK_SECRET=""
# Seed price ids of the original plans (scripts/paddle-setup.mjs prints them).
PADDLE_PRICE_STANDARD_MONTH=""
PADDLE_PRICE_STANDARD_YEAR=""
PADDLE_PRICE_PRO_MONTH=""
PADDLE_PRICE_PRO_YEAR=""

# --- Canva ("Edit in Canva", docs/CANVA.md). Empty hides it. ---
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""
# Must match a Redirect URL in the portal. Empty = NEXT_PUBLIC_SITE_URL + /api/canva/callback (locally use 127.0.0.1).
CANVA_REDIRECT_URI=""

# --- Google Calendar for demo bookings (docs/GOOGLE_CALENDAR.md). Empty = meeting link and .ics only. ---
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# --- Imports: Google Drive, Dropbox, Shopify (docs/CONNECTORS.md). Empty shows "Coming soon". ---
# Browser key restricted to the Picker API and the site's domains.
GOOGLE_PICKER_API_KEY=""
# OAuth web client id. Empty = GOOGLE_YOUTUBE_CLIENT_ID.
GOOGLE_CLIENT_ID=""
# The Google Cloud project NUMBER.
GOOGLE_PICKER_APP_ID=""
DROPBOX_APP_KEY=""
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Admin API version. Empty = 2026-07.
SHOPIFY_API_VERSION=""

# --- Addresses and location (docs/BUSINESS_INFO.md, docs/REGIONS.md) ---
# Server-only key with Places API (New) and Geocoding API. Empty = plain address inputs.
GOOGLE_MAPS_API_KEY=""
# "Use my location": builtin (offline, free) or google (needs GOOGLE_MAPS_API_KEY). Empty = builtin.
GEO_PROVIDER=""

# --- Website chat and sign-up protection (docs/WIDGET.md) ---
# Cloudflare Turnstile. Empty (both) = rate limits only.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Hosting (docs/DEPLOY_NETLIFY.md) ---
# netlify, cloudflare or node. Empty = detected.
PLATFORM=""
# "1" turns on GET /api/platform/check for the 10-minute post-deploy check only. Never leave it on.
PLATFORM_CHECK=""

# --- Local development only. Never set these in production (check-env refuses them). ---
# Country recorded when no host header gives one (default ZZ).
ANALYTICS_DEV_COUNTRY=""
# "1" lets ?region=RW override the visitor's region on public pages.
REGION_OVERRIDE=""

# --- GitHub Actions only (secrets and variables there, never in Netlify) ---
# Deploy workflow: the Netlify token and site id (environment `production` secrets).
NETLIFY_AUTH_TOKEN=""
NETLIFY_SITE_ID=""
# Video robot workflow: the site the robot calls (repository variable), e.g. https://bupulse.com.
ROBOT_APP_URL=""
# The commit being built (the deploy workflows set it).
BUILD_SHA=""
