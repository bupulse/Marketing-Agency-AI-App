# BuPulse environment variables. Copy to .env and fill in; never commit .env. Only NEXT_PUBLIC_* values reach the
# browser. Production: runtime values go in Netlify (Project configuration, Environment variables), build values in the
# GitHub `production` environment (docs/DEPLOY_NETLIFY.md). `node --env-file=.env scripts/check-env.mjs --runtime`
# checks a filled-in file; the deploy workflow runs the same checks (names and problems only, never values).
# Empty = not set; the comment says what happens then. [required] = production must have it.

# --- Site ---
# [required] The site's address: http://localhost:3000 in development, https://bupulse.com in production. Also a build value.
NEXT_PUBLIC_SITE_URL=""
# Other addresses that serve this same app (comma-separated, e.g. a test tunnel https://test.bupulse.com). Sign-in and
# email links return to the address the visitor is on if it is listed here or is NEXT_PUBLIC_SITE_URL. Production: empty.
AUTH_EXTRA_ORIGINS=""
# Address for links opened on other devices (sales TV, referral links, staff invitations). Empty = NEXT_PUBLIC_SITE_URL.
# Production: empty. A test machine behind a tunnel: the tunnel address, e.g. https://test.bupulse.com.
PUBLIC_LINK_URL=""
# The support app's address, for agents' invite and new-password links (docs/SUPPORT_CHAT.md "Support app and Admin").
# Empty = PUBLIC_LINK_URL (or NEXT_PUBLIC_SITE_URL) + /support. Production, once the domain alias is set up:
# https://support.bupulse.com
SUPPORT_APP_URL=""
# Public WhatsApp number for the "Chat on WhatsApp" button (international format, e.g. +250 791 954 277). Empty hides it.
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# --- Supabase (Project Settings, API) ---
# [required] Also build values (GitHub variables).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# [required] Secret key (sb_secret_...): server-only Storage work (Gallery videos, voiceovers, music, purges).
SUPABASE_SECRET_KEY=""
# Scripts only, never the app: a personal access token (Account, Access Tokens) for scripts/supabase-auth-emails.mjs,
# which installs the auth emails and URL settings (docs/EMAIL_SETUP.md). Pass it on the command line, not in a deploy.
SUPABASE_ACCESS_TOKEN=""

# --- Database (Supabase, Connect, ORMs, Prisma) ---
# [required] Pooled "transaction" connection (port 6543, ?pgbouncer=true), used by the app at runtime.
DATABASE_URL=""
# Direct "session" connection (port 5432), for migrations only (a GitHub secret in production, not in Netlify).
DIRECT_URL=""
# Connections per pooled client (1 to 20). Empty = 3 on Netlify, 10 elsewhere.
DATABASE_POOL_MAX=""
# The database size the admin Health page measures against, in MB. Empty = 500 (Supabase free plan).
DB_SIZE_LIMIT_MB=""

# --- Secrets ---
# [required] Base64, 32 bytes (openssl rand -base64 32): encrypts third-party tokens. Never change it after go-live.
# To rotate: set ENCRYPTION_KEY_ID="2", put the new key in ENCRYPTION_KEY and the old one in ENCRYPTION_KEY_1.
ENCRYPTION_KEY=""
ENCRYPTION_KEY_ID=""
# [required] Mixed into API key hashes (openssl rand -base64 32). Changing it invalidates every API key.
API_KEY_PEPPER=""
# [required] Bearer token of the scheduled jobs (openssl rand -hex 32); the same value as the GitHub secret.
CRON_SECRET=""
# Signs billing links. Empty = derived from ENCRYPTION_KEY.
BILLING_SIGNING_SECRET=""

# --- Admin console (/admin) ---
# [required] Comma-separated addresses allowed in (each also needs an authenticator-app code).
ADMIN_EMAILS=""
# Admin, Settings, Updates (docs/UPDATES.md): the repository (owner/name) and a fine-grained token (Actions: write,
# Contents: read). Empty shows "Not connected".
GITHUB_REPO=""
GITHUB_TOKEN=""
# Which deploy workflow Updates starts: netlify or cloudflare. Empty = the host BuPulse runs on.
DEPLOY_TARGET=""
# Extra origins allowed to call the admin MCP endpoint (comma-separated). Empty = this site only.
MCP_ALLOWED_ORIGINS=""

# --- AI ---
# [required] "gemini" or "claude": who writes the text.
AI_TEXT_PROVIDER=""
# Gemini: the text when AI_TEXT_PROVIDER=gemini, and always the AI designs and photos.
GEMINI_API_KEY=""
# Empty = the built-in default models.
GEMINI_TEXT_MODEL=""
GEMINI_TEXT_FALLBACK_MODEL=""
GEMINI_IMAGE_MODEL=""
# Image engine (docs/IMAGE_ENGINE.md): the Pro tier's model (Nano Banana Pro, 4 credits a picture).
GEMINI_IMAGE_PRO_MODEL=""
# The Lite tier's model (Nano Banana 2, 2 credits a picture).
GEMINI_IMAGE_LITE_MODEL=""
# The owner's Claude subscription for the image engine's Prompter: TEST SITE ONLY (the Mac serving test.bupulse.com),
# never on Netlify or Cloudflare; set to 1 to allow it there. ANTHROPIC_API_KEY wins when set.
IMAGE_ENGINE_CLAUDE_SUBSCRIPTION=""
# Path of the `claude` CLI for that, when it is not on PATH.
IMAGE_ENGINE_CLAUDE_BIN=""
# Temporary reel engine (docs/REEL_ENGINE.md): the company ids it is on for while it is tested (comma-separated),
# and the owner's test budget in USD for all reels together (10 when empty). It also needs the "veo" service switched on.
REEL_ENGINE_BUSINESSES=""
REEL_TEST_CAP_USD=""
# Claude: the text when AI_TEXT_PROVIDER=claude.
ANTHROPIC_API_KEY=""
CLAUDE_TEXT_MODEL=""
CLAUDE_EFFORT=""
# Short structured calls (interview, voiceover shortening). Empty = the provider's cheap model.
CHEAP_TEXT_MODEL=""
# Monthly cap on BuPulse's whole AI spend in USD (AI pauses at it; Admin, AI usage can override it). Empty = the default.
AI_MONTHLY_BUDGET_USD=""
# Monthly AI allowance per company in USD (every AI feature). Empty = 3.
AI_COMPANY_MONTHLY_USD=""
# Share (0 to 1) of a company's allowance the website chat may use. Empty = 0.5.
WIDGET_AI_SHARE=""
# Model for website chat replies. Empty = gemini-3.1-flash-lite.
WIDGET_MODEL=""

# --- Voiceover and music (docs/VOICE_AND_MUSIC.md) ---
# ElevenLabs (paid plan): voiceovers and "Generate a track". Server-only; empty turns both off.
ELEVENLABS_API_KEY=""
# Empty = eleven_multilingual_v2.
ELEVENLABS_MODEL=""

# --- Kept ready, no feature uses them yet (Admin -> Services; keys can also be saved there instead of here) ---
# Seedance 2.0 AI video (BytePlus ModelArk API key). Empty = not connected.
SEEDANCE_API_KEY=""
# Empty = dreamina-seedance-2-0-260128 (or dreamina-seedance-2-0-fast-260128, cheaper).
SEEDANCE_MODEL=""
# Empty = https://ark.ap-southeast.bytepluses.com/api/v3 (international region).
SEEDANCE_BASE_URL=""
# Empty = BytePlus list price for Seedance Pro, 7 US dollars per million tokens (Fast and Mini follow it).
SEEDANCE_USD_PER_M_TOKENS=""
# AI clips in videos (uses GEMINI_API_KEY above; billing must be on). Empty = gemini-omni-1.1-flash (Gemini Omni
# Flash; Google shut the Veo 3.1 previews down on 22 October 2026).
VEO_MODEL=""
# Empty = the Gemini API list price of the model, about 0.10 US dollars a second for Gemini Omni Flash at 720p.
VEO_USD_PER_SECOND=""
# BuPulse's own limit on overnight AI clips for Autopilot / Daily posts videos (lib/visuals/ai-clips.ts): clips
# submitted in 24 hours for all companies (default 10, about $6 a day with Gemini Omni); past it the videos are simple slideshows.
VEO_CLIPS_PER_DAY=""
# BuPulse's own Composio account (project API key), "BuPulse-Socials". When set, clients connect Facebook, Instagram,
# LinkedIn and YouTube through Composio's approved apps (lib/social/composio). Empty = not connected.
COMPOSIO_API_KEY=""
# TikTok and X have no Composio-managed sign-in: each needs an auth config made in Composio with BuPulse's own
# developer app (docs/PLATFORM_APPS.md, "TikTok and X through BuPulse-Socials"). Their ids (ac_...). Empty = that
# network shows "Coming soon" in Channels and, for TikTok, on the creators' Connections page (docs/CREATOR_CAMPAIGNS.md).
# The TikTok app needs user.info.basic, user.info.profile, user.info.stats (creators' follower counts), video.upload,
# video.publish and video.list. X also stays off until it is switched on in Admin -> Services (it costs per post).
COMPOSIO_TIKTOK_AUTH_CONFIG_ID=""
COMPOSIO_TWITTER_AUTH_CONFIG_ID=""
# "true" once TikTok's audit passed: videos are posted on the profile. Empty = they go to the TikTok inbox, where the
# owner adds the caption and posts (unaudited direct posts are private for good).
TIKTOK_DIRECT_POST=""
# Networks that use BuPulse's own apps instead of BuPulse-Socials, comma-separated (e.g. facebook,instagram once Meta
# has verified BuPulse). Empty = every network Composio can sign in goes through BuPulse-Socials.
SOCIALS_DIRECT=""
# The Video Studio's own site (docs/VIDEO_STUDIO_SPLIT.md), opened from BuPulse with one-click sign-in. Empty =
# https://studio.bupulse.com.
STUDIO_URL=""
# The studio's mode: empty for the local test studio, "production" at studio.bupulse.com (API key only, TEST database refused).
STUDIO_ENV=""
# Signs the studio's 12-hour client cookie (32 or more random characters, e.g. openssl rand -hex 32). Empty = no client can sign in.
STUDIO_SESSION_SECRET=""
# BuPulse's address, where the studio sends a person with no session and "Buy credits" goes. Empty = https://bupulse.com.
BUPULSE_URL=""
# Test only ("1"): tickets "dev-<businessId>" sign in as that business's owner, to try a client session without BuPulse. Never in production.
STUDIO_DEV_TICKETS=""
# Test only: other folders for the studio's Viral library (made-up rows and frames). Empty = docs/research/viral and video-lab/data/viral/frames.
VIRAL_ROWS_DIR=""
VIRAL_FRAMES_DIR=""
# Test only: scripts/video-lab/qa-client.mjs. The two test businesses (ids; empty = the TEST database's E2E Starter Test and
# Nova Phones Kigali), a screenshot path, and "1" to keep its test videos instead of removing them.
QA_BUSINESS=""
QA_VIDEO_BUSINESS=""
QA_SHOT=""
QA_KEEP=""

# --- Storage (docs/MEDIA.md) ---
# Shared storage guard in bytes (Supabase free plan: 1 GB in all). Empty = 900 MB.
MEDIA_PLATFORM_MAX_BYTES=""
# Gallery videos per company in bytes. Empty = 100 MB (104857600).
MEDIA_COMPANY_VIDEO_MAX_BYTES=""

# --- Video robot (docs/VIDEO_ROBOT.md) ---
# Long random string (openssl rand -hex 32), the same as the GitHub secret. Empty = owners make videos in their browser.
VIDEO_ROBOT_SECRET=""

# --- Email (Resend, docs/EMAIL_SETUP.md) ---
# [required] Sign-in links, reminders, invoices and digests.
RESEND_API_KEY=""
# Sender, e.g. "BuPulse <hello@bupulse.com>". Empty = the built-in default.
RESEND_FROM=""

# --- Social networks (docs/PLATFORM_APPS.md). Empty hides that network's Connect button. ---
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Instagram Login (optional; Instagram through Facebook works without it).
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
# Another Meta app secret the data-deletion callback accepts (optional).
META_APP_SECRET=""
# Social inbox, Meta direct route only (docs/SOCIAL_INBOX.md): any long random text, also typed into the Meta app's
# webhook settings. Empty keeps the webhook closed.
META_WEBHOOK_VERIFY_TOKEN=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# "true" once LinkedIn approved Community Management (company pages).
LINKEDIN_COMMUNITY_MANAGEMENT=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# "true" once TikTok verified the media domain (photo posts).
TIKTOK_PHOTO_POSTING=""
GOOGLE_YOUTUBE_CLIENT_ID=""
GOOGLE_YOUTUBE_CLIENT_SECRET=""

# --- Billing (Paddle, docs/BILLING.md). Empty = Mobile Money and invoices only. ---
BILLING_PROVIDER=""
# sandbox or production.
PADDLE_ENVIRONMENT=""
PADDLE_API_KEY=""
PADDLE_CLIENT_TOKEN=""
PADDLE_WEBHOOK_SECRET=""
# Seed price ids of the original plans (scripts/paddle-setup.mjs prints them).
PADDLE_PRICE_STANDARD_MONTH=""
PADDLE_PRICE_STANDARD_YEAR=""
PADDLE_PRICE_PRO_MONTH=""
PADDLE_PRICE_PRO_YEAR=""

# --- Canva ("Edit in Canva", docs/CANVA.md). Empty hides it. ---
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""
# Must match a Redirect URL in the portal. Empty = NEXT_PUBLIC_SITE_URL + /api/canva/callback (locally use 127.0.0.1).
CANVA_REDIRECT_URI=""

# --- Lead alerts on phones and browsers (Web Push, free; docs/RELEASE_2.0.md "Lead alerts"). Empty hides the
# "Alerts on this device" switch. Each environment needs its OWN pair (production never reuses the local one):
#   node -e "const c=require('crypto'),e=c.createECDH('prime256v1');e.generateKeys();const b=x=>x.toString('base64url');console.log('VAPID_PUBLIC_KEY='+b(e.getPublicKey())+'\nVAPID_PRIVATE_KEY='+b(e.getPrivateKey()))"
# Changing the pair later means every device must switch alerts on again. VAPID_SUBJECT: a contact for the push
# services, mailto:office@bupulse.com.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT=""

# --- WhatsApp lead alerts (WhatsApp Cloud API, paid per message; docs/RELEASE_2.0.md "WhatsApp alerts"). OFF until
# these are set AND the WhatsApp service is switched on in Admin -> Services. ---
# A permanent System User token with whatsapp_business_messaging, and the id of BuPulse's sending number.
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# The approved utility template's name and language. Empty = new_lead_alert, en.
WHATSAPP_ALERT_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE=""

# --- Google Calendar for demo bookings (docs/GOOGLE_CALENDAR.md). Empty = meeting link and .ics only. ---
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# --- Imports: Google Drive, Dropbox, Shopify (docs/CONNECTORS.md). Empty shows "Coming soon". ---
# Browser key restricted to the Picker API and the site's domains.
GOOGLE_PICKER_API_KEY=""
# OAuth web client id. Empty = GOOGLE_YOUTUBE_CLIENT_ID.
GOOGLE_CLIENT_ID=""
# The Google Cloud project NUMBER.
GOOGLE_PICKER_APP_ID=""
DROPBOX_APP_KEY=""
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Admin API version. Empty = 2026-07.
SHOPIFY_API_VERSION=""

# --- Addresses and location (docs/BUSINESS_INFO.md, docs/REGIONS.md) ---
# Server-only key with Places API (New) and Geocoding API. Empty = plain address inputs.
GOOGLE_MAPS_API_KEY=""
# "Use my location": builtin (offline, free) or google (needs GOOGLE_MAPS_API_KEY). Empty = builtin.
GEO_PROVIDER=""

# --- Website chat and sign-up protection (docs/WIDGET.md) ---
# Cloudflare Turnstile. Empty (both) = rate limits only.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- BuPulse support chat (docs/SUPPORT_CHAT.md section 9) ---
# The support AI's Gemini model. Empty = WIDGET_MODEL, else gemini-3.1-flash-lite (free tier); GEMINI_TEXT_MODEL is the fallback.
SUPPORT_MODEL=""

# --- Hosting (docs/DEPLOY_NETLIFY.md) ---
# netlify, cloudflare or node. Empty = detected.
PLATFORM=""
# "1" turns on GET /api/platform/check for the 10-minute post-deploy check only. Never leave it on.
PLATFORM_CHECK=""

# --- Local development only. Never set these in production (check-env refuses them). ---
# Country recorded when no host header gives one (default ZZ).
ANALYTICS_DEV_COUNTRY=""
# "1" lets ?region=RW override the visitor's region on public pages.
REGION_OVERRIDE=""

# --- GitHub Actions only (secrets and variables there, never in Netlify) ---
# Deploy workflow: the Netlify token and site id (environment `production` secrets).
NETLIFY_AUTH_TOKEN=""
NETLIFY_SITE_ID=""
# Video robot workflow: the site the robot calls (repository variable), e.g. https://bupulse.com.
ROBOT_APP_URL=""
# The commit being built (the deploy workflows set it).
BUILD_SHA=""

# The sales room TV's monthly goal in whole Rwandan francs (Admin -> Organisation -> Sales screen). Default 9000000.
SALES_MONTHLY_GOAL_RWF=""

# Install from a signed zip (docs/UPDATES.md): the release public key when scripts/release-public-key.mjs is empty,
# and UPDATES_DRY_RUN=1 on the test machine (every check runs, the deploy workflow is not started).
RELEASE_PUBLIC_KEY=""
UPDATES_DRY_RUN=""
