# Copy to .env and fill in. Never commit .env. Only NEXT_PUBLIC_* values reach the browser.

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- Supabase database (Connect button → ORMs → Prisma) ---
# Pooled "transaction" connection, used by the app at runtime:
DATABASE_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct "session" connection, used by Prisma migrations:
DIRECT_URL="postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- AI providers ---
# "gemini" (free tier, for development) or "claude"
AI_TEXT_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
CLAUDE_TEXT_MODEL="claude-opus-5-5"
CLAUDE_EFFORT="medium"

# --- Encryption (third-party tokens, users' own Composio keys) ---
# Base64, 32 bytes. Generate with: openssl rand -base64 32
# To rotate: set ENCRYPTION_KEY_ID="2", put the new key in ENCRYPTION_KEY and the old one in ENCRYPTION_KEY_1
ENCRYPTION_KEY=""

# --- Account deletion (daily purge job) ---
# Supabase → Project Settings → API Keys → secret key (sb_secret_…). Lets the purge job remove Storage files.
SUPABASE_SECRET_KEY=""
# Any long random string (openssl rand -hex 32). Same value in Cloudflare secrets and GitHub Actions secrets.
CRON_SECRET=""

# --- Later phases (not used yet) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
ELEVENLABS_API_KEY=""

# --- Billing (Paddle; see docs/BILLING.md) ---
BILLING_PROVIDER=""
PADDLE_ENVIRONMENT=""
PADDLE_API_KEY=""
PADDLE_CLIENT_TOKEN=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_PRICE_STANDARD_MONTH=""
PADDLE_PRICE_STANDARD_YEAR=""
PADDLE_PRICE_PRO_MONTH=""
PADDLE_PRICE_PRO_YEAR=""
