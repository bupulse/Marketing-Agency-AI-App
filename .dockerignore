# What the Cloud Run image build (Dockerfile) never sees. Secrets first: no .env file of any kind, no keys.
.env
.env.*
!.env.example
*.pem
*.key
*cloudrun-env*.yaml
*.env.yaml

# Built or installed inside the image instead.
node_modules
.next
.open-next
.netlify
.wrangler
.dev.vars
lib/generated/prisma
*.tsbuildinfo
coverage
out
build

# Not part of the app: tests, the docs (except the support guide pages the app reads), demos and scratch (tools/ stays: app code imports tools/blender/scene.ts).
.git
.github
.claude
.agents
.windsurf
tests
e2e
playwright-report
test-results
